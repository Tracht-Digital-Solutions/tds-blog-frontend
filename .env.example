# tds-blog — local dev environment
#
# Copy to `.env` (gitignored) before `npm run dev` or `npm run build`.
# The blog is a static-rendered Astro site that pulls posts from
# tds-content-api at build time.

# Source of truth for blog posts. The build script reads this once per
# build; failure surfaces as a hard error rather than silently shipping
# an empty index.
CONTENT_API_URL=https://api.tracht-digital.de/content

# Public content-API base for the *runtime* article-page view beacon
# (POST /blog/{slug}/view, feeds the hero's "Populär" tab). Must be a
# PUBLIC_ var so it's exposed to the browser; the build-time
# CONTENT_API_URL above is not. Optional — defaults to the production
# gateway when unset.
PUBLIC_CONTENT_API_URL=https://api.tracht-digital.de/content

# Demo-Modus (Build-Zeit). Mit `true` baut der Blog mit eingebackenen
# Demo-Artikeln, statt von der Content-API zu lesen — die statische Seite
# rendert dann komplett ohne Backend.
PUBLIC_DEMO_MODE=false

# --- shell-only ---
# NPM_TOKEN authenticates against GitHub Packages for tds-shared.
# Set in your shell, not in this file.
#   PowerShell:  $env:NPM_TOKEN = "ghp_…"
#   bash/zsh:    export NPM_TOKEN=ghp_…

# DeepL API key for build-time fallback translation of blog posts that
# lack a language version (see src/lib/translate.ts). Free-tier keys end
# with ":fx". Optional: unset → posts render in their authored language
# instead of being translated (the build never fails on this).
# DEEPL_API_KEY=
