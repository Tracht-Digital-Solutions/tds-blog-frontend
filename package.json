{
  "name": "tds-blog-frontend",
  "version": "0.31.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "type-check": "astro check",
    "og:smoke": "tsx scripts/og-smoke.ts",
    "og:default": "tsx scripts/og-default.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "postbuild": "node scripts/pack-release.mjs",
    "start": "node app.cjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^11.1.4",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@fontsource/lato": "^5.2.7",
    "@tailwindcss/postcss": "~4.3.3",
    "@tracht-digital-solutions/tds-shared": "^0.34.0",
    "astro": "^7.2.5",
    "marked": "^18.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^4.4.3",
    "tailwindcss": "~4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "satori": "^0.33.4",
    "tsx": "^4.22.3",
    "vitest": "^4.1.11"
  },
  "tds": {
    "notes": {
      "release": "What scripts/pack-release.mjs assembles for the production host. runtimeDependencies must stay PUBLIC-REGISTRY ONLY: the host has no GitHub Packages token, and everything first-party is bundled into server/ by vite.ssr.noExternal instead."
    },
    "release": {
      "name": "tds-blog-release",
      "runtimeDependencies": {
        "@astrojs/node": "^11.1.4",
        "@astrojs/rss": "^4.0.19",
        "@resvg/resvg-js": "^2.6.2",
        "astro": "^7.2.5",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "sharp": "^0.35.0",
        "satori": "^0.33.4"
      },
      "extraFiles": [
        { "from": "src/og/fonts", "to": "assets/og-fonts" }
      ]
    }
  }
}
