---
import type { BlogPost } from "@tracht-digital-solutions/tds-shared";
import PostCard from "~/components/PostCard.tsx";

interface Props {
  /** All posts for the current language (passed in from the page so we don't refetch). */
  posts: Array<
    Pick<BlogPost, "slug" | "lang" | "category" | "title" | "excerpt" | "publishedAt" | "coverHint">
  >;
  currentSlug: string;
  currentCategory: string;
  lang: "de" | "en";
  limit?: number;
}

const { posts, currentSlug, currentCategory, lang, limit = 3 } = Astro.props;

/**
 * Pick the top-N most recent posts in the same category, excluding
 * the current one. Falls back to the most recent posts overall if
 * the category yields fewer than `limit` siblings so the strip never
 * feels half-empty.
 */
const byDate = (a: { publishedAt: string | null }, b: { publishedAt: string | null }) =>
  (b.publishedAt ?? "").localeCompare(a.publishedAt ?? "");

const sameCategory = posts
  .filter((p) => p.slug !== currentSlug && p.category === currentCategory)
  .sort(byDate);

let picks = sameCategory.slice(0, limit);
if (picks.length < limit) {
  const fallback = posts
    .filter(
      (p) => p.slug !== currentSlug && !picks.some((q) => q.slug === p.slug),
    )
    .sort(byDate)
    .slice(0, limit - picks.length);
  picks = [...picks, ...fallback];
}

const labels = {
  de: { eyebrow: "Weiterlesen" },
  en: { eyebrow: "Keep reading" },
}[lang];
---

{picks.length > 0 && (
  <aside class="mt-16 pt-2" aria-labelledby="related-heading">
    <p class="section-num mb-3">{labels.eyebrow}</p>
    <h2 id="related-heading" class="display-tight text-3xl mb-6">
      {lang === "de" ? "Ähnliche Artikel." : "Adjacent articles."}
    </h2>

    <ul class="grid md:grid-cols-3 gap-5 list-none p-0 m-0">
      {picks.map((p) => (
        <li class="flex">
          {/* Static render of the flat design-system card — no hydration. */}
          <PostCard post={p} lang={lang} />
        </li>
      ))}
    </ul>
  </aside>
)}
