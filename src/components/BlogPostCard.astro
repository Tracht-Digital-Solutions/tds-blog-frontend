---
/**
 * Flat editorial list row from the design-system blog kit: colour
 * block instead of rule lines — meta column left, serif title +
 * excerpt centre, arrow right. Used on the pagination and tag pages.
 */
interface Props {
  slug: string;
  category: string;
  title: string;
  excerpt: string;
  publishedAt: string | null;
  lang?: "de" | "en";
}

const { slug, category, title, excerpt, publishedAt, lang = "de" } = Astro.props;
const locale = lang === "de" ? "de-DE" : "en-US";
---

<li class="list-none">
  <a href={`${lang === "en" ? "/en" : ""}/${slug}`} class="post-row">
    <div class="flex flex-col gap-2.5">
      <p class="eyebrow" style="color: var(--color-accent);">{category}</p>
      {publishedAt && (
        <time class="tabular text-[0.8125rem] text-[var(--color-muted)]" datetime={publishedAt}>
          {new Date(publishedAt).toLocaleDateString(locale, {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
      )}
    </div>
    <div>
      <h2 class="row-title">{title}</h2>
      <p class="text-[0.9375rem] leading-relaxed text-[var(--color-muted)] m-0 max-w-prose" style="text-wrap: pretty;">
        {excerpt}
      </p>
    </div>
    <span class="row-arrow hidden md:block" aria-hidden="true">→</span>
  </a>
</li>
