---
interface Props {
  slug: string;
  category: string;
  title: string;
  excerpt: string;
  publishedAt: string | null;
  lang?: "de" | "en";
}

const { slug, category, title, excerpt, publishedAt, lang = "de" } = Astro.props;
const locale = lang === "de" ? "de-DE" : "en-US";
---

<li class="hairline-b last:border-b-0 py-10">
  <a href={`/${slug}`} class="block group editorial-grid items-start">
    <div>
      <p class="eyebrow mb-3">{category}</p>
      <h2 class="display-tight text-3xl md:text-4xl mb-3 group-hover:text-[var(--color-accent)] transition-colors">
        {title}
      </h2>
      <p class="text-[var(--color-muted)] leading-relaxed max-w-prose">
        {excerpt}
      </p>
    </div>
    <aside class="marginalia lg:pt-2">
      {publishedAt && (
        <time class="tabular block" datetime={publishedAt}>
          {new Date(publishedAt).toLocaleDateString(locale, {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
      )}
      <p class="mt-1">
        <span class="link-underline text-[var(--color-accent)]">Lesen →</span>
      </p>
    </aside>
  </a>
</li>
