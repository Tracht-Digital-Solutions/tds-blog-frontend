---
/**
 * Flat editorial list row from the design-system blog kit: colour
 * block instead of rule lines — meta column left, serif title +
 * excerpt centre, arrow right. Used on the pagination and tag pages.
 */
interface Props {
  slug: string;
  category: string;
  title: string;
  excerpt: string;
  publishedAt: string | null;
  /** Reading time from the list API — the book's thickness and label. */
  readingMinutes?: number | null;
  lang?: "de" | "en";
}

import { bookClass, bookLabel } from "~/lib/book";

const { slug, category, title, excerpt, publishedAt, readingMinutes = null, lang = "de" } = Astro.props;
const book = bookLabel(readingMinutes, lang);
const locale = lang === "de" ? "de-DE" : "en-US";
---

<li class="list-none">
  <a href={`${lang === "en" ? "/en" : ""}/${slug}`} class:list={["post-row", bookClass(readingMinutes)]}>
    <div class="flex flex-col gap-2.5">
      <p class="eyebrow card-meta" style="color: var(--color-accent);">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 7.5 11 3l8 4.5v9L11 21l-8-4.5z" /><circle cx="11" cy="9" r="1.4" />
        </svg>
        {category}
      </p>
      {publishedAt && (
        <time class="tabular card-meta text-[0.8125rem] text-[var(--color-muted)]" datetime={publishedAt}>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4.5" width="18" height="16" /><path d="M3 9h18M8 2.5v4M16 2.5v4" />
          </svg>
          {new Date(publishedAt).toLocaleDateString(locale, {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
      )}
      {book && (
        <span class="book-meta tabular">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z" /><path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5" />
          </svg>
          {book}
        </span>
      )}
    </div>
    <div>
      <h2 class="row-title">{title}</h2>
      <p class="text-[0.9375rem] leading-relaxed text-[var(--color-muted)] m-0 max-w-prose" style="text-wrap: pretty;">
        {excerpt}
      </p>
    </div>
    <span class="row-arrow hidden md:block" aria-hidden="true">→</span>
  </a>
</li>
