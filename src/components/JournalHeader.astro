---
/**
 * Flat top nav from the design-system blog kit: logomark + wordmark,
 * bordeaux divider square, angular nav items, live search field,
 * DE/EN segmented toggle and the primary CTA.
 *
 * The primary nav is Journal · Entdecken ▾ · RSS. "Entdecken" opens a flat
 * disclosure panel grouping the corpus into Kategorien · Beliebte Tags ·
 * Aktuelle Themen (all built from `getTaxonomy()` at build time).
 *
 * Below `md` the bar carries just the logo + a hamburger; the hamburger
 * opens a flat **full-screen overlay menu** (large editorial links, the
 * Entdecken group expanded inline) and locks body scroll. Search is a
 * desktop-only affordance. Desktop (≥md) is unchanged.
 *
 * The desktop search field drives the BlogIndex island when one is on the
 * page (CustomEvent `tds-blog-search`, flagged via `data-blog-live-search`
 * on <html>); everywhere else Enter navigates to the index with `?q=`.
 */
import { ThemeToggle } from "@tracht-digital-solutions/tds-shared/components";
import {
  primaryNav,
  isActiveNav,
  isEntdeckenActive,
  entdeckenLabels,
  categoryHref,
  tagHref,
  topicsHref,
} from "~/lib/nav";
import { getTaxonomy } from "~/lib/taxonomy";

interface Props {
  lang?: "de" | "en";
  class?: string;
}

const { lang = "de", class: className } = Astro.props;

const home = lang === "de" ? "/" : "/en/";
const nav = primaryNav(lang);
const path = Astro.url.pathname;
const labels = entdeckenLabels(lang);
const { categories, topTags } = await getTaxonomy(lang);
const entdeckenActive = isEntdeckenActive(path);
const searchPlaceholder = lang === "de" ? "Suchen …" : "Search …";
const cta = lang === "de" ? "Termin vereinbaren" : "Book a meeting";
const menuLabel = lang === "en" ? "Menu" : "Menü";
const closeLabel = lang === "en" ? "Close menu" : "Menü schließen";
---

<header class:list={["brand-header", className]}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 min-h-15 py-2.5 flex flex-nowrap items-center gap-x-2 sm:gap-x-4">
    <a
      href={home}
      aria-label="Tracht Journal"
      class="brand-wordmark text-[0.9375rem] sm:text-[1.0625rem] tracking-tight shrink-0 whitespace-nowrap inline-flex items-center gap-1.5 sm:gap-2"
    >
      <span class="brand-logo" aria-hidden="true"></span>
      <span class="accent-italic">Journal</span>
    </a>
    <span class="nav-divider hidden sm:block" aria-hidden="true"></span>

    <nav class="hidden md:flex items-center gap-1 flex-1 min-w-0" aria-label="Navigation">
      {nav.map((node) =>
        node.kind === "link" ? (
          <a
            href={node.href}
            class="jnav-item whitespace-nowrap"
            aria-current={isActiveNav(node.href, path) ? "page" : undefined}
          >
            {node.label}
          </a>
        ) : (
          <div class="jnav-dd" id="jnl-entdecken">
            <button
              type="button"
              id="jnl-entdecken-btn"
              class="jnav-item jnav-dd-btn whitespace-nowrap"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="jnl-entdecken-panel"
              aria-current={entdeckenActive ? "true" : undefined}
            >
              <span>{node.label}</span>
              <svg class="jnav-dd-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
            </button>
            <div id="jnl-entdecken-panel" class="jnav-dropdown" data-open="false" role="group" aria-label={node.label}>
              <div class="jnav-dd-col">
                <p class="jnav-dd-head">{labels.categories}</p>
                {categories.length === 0 ? (
                  <p class="jnav-dd-empty">—</p>
                ) : (
                  <div class="jnav-dd-links">
                    {categories.map((c) => (
                      <a href={categoryHref(lang, c.slug)} class="jnav-dd-link">
                        <span>{c.name}</span>
                        <span class="jnav-dd-count">{c.count}</span>
                      </a>
                    ))}
                  </div>
                )}
              </div>
              <div class="jnav-dd-col">
                <p class="jnav-dd-head">{labels.tags}</p>
                {topTags.length === 0 ? (
                  <p class="jnav-dd-empty">—</p>
                ) : (
                  <div class="jnav-dd-chips">
                    {topTags.map((t) => (
                      <a href={tagHref(lang, t.name)} class="chip-flat chip-flat--sm">#{t.name}</a>
                    ))}
                  </div>
                )}
              </div>
              <div class="jnav-dd-col">
                <p class="jnav-dd-head">{labels.topics}</p>
                <a href={topicsHref(lang)} class="jnav-dd-link jnav-dd-link--lead">
                  <span>{labels.topics}</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </div>
        )
      )}
    </nav>

    <div class="nav-search hidden md:flex">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M10.8 10.8L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
      <input
        type="search"
        id="jnl-search"
        class="js-blog-search"
        placeholder={searchPlaceholder}
        aria-label={searchPlaceholder}
        data-index-url={home}
      />
    </div>

    {/* Push the mobile controls to the right (the desktop nav already takes
        the flex space from md up). */}
    <div class="flex-1 md:hidden"></div>

    {/* Right-hand controls. Language, theme and the CTA only show from md
        up; on mobile just the hamburger remains. */}
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <div class="hidden md:flex items-center gap-2">
        <div class="lang-toggle" role="group" aria-label="Sprache / Language">
          <a href="/" class={lang === "de" ? "on" : ""} aria-current={lang === "de" ? "true" : undefined}>DE</a>
          <a href="/en/" class={lang === "en" ? "on" : ""} aria-current={lang === "en" ? "true" : undefined}>EN</a>
        </div>

        <ThemeToggle client:idle />

        <a href="https://tracht-digital.de/#contact" class="btn-flat" style="height: 2.25rem;">
          {cta}
        </a>
      </div>

      <button
        id="jnl-menu-toggle"
        type="button"
        class="jnl-menu-toggle md:hidden relative inline-flex items-center justify-center w-11 h-11 text-[var(--color-primary)] hover:bg-[var(--color-soft)] transition-colors cursor-pointer"
        aria-controls="jnl-mobile-menu"
        aria-expanded="false"
        aria-label={menuLabel}
      >
        <span class="jnl-menu-bar jnl-menu-bar-top" aria-hidden="true"></span>
        <span class="jnl-menu-bar jnl-menu-bar-mid" aria-hidden="true"></span>
        <span class="jnl-menu-bar jnl-menu-bar-bot" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  {/* Full-screen overlay menu — a flat surface (no glass) carrying the large
      editorial nav, the Entdecken group expanded inline, plus the language /
      theme controls and the CTA kept off the bar below md. */}
  <div
    id="jnl-mobile-menu"
    class="jnl-fullmenu md:hidden"
    data-open="false"
    aria-hidden="true"
    aria-label={menuLabel}
  >
    <div class="jnl-fullmenu-head max-w-5xl mx-auto w-full">
      <span class="brand-wordmark inline-flex items-center gap-2 text-[1.0625rem] tracking-tight">
        <span class="brand-logo" aria-hidden="true"></span>
        <span class="accent-italic">Journal</span>
      </span>
      <button
        id="jnl-menu-close"
        type="button"
        class="jnl-fullmenu-close"
        aria-label={closeLabel}
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <nav class="jnl-fullmenu-nav max-w-5xl mx-auto w-full" aria-label="Navigation">
      {nav.map((node) =>
        node.kind === "link" ? (
          <a
            href={node.href}
            data-menu-link
            class="jnl-fullmenu-link"
            aria-current={isActiveNav(node.href, path) ? "page" : undefined}
          >
            {node.label}
          </a>
        ) : (
          <div class="jnl-fullmenu-group">
            <p class="jnl-fullmenu-sub">{labels.categories}</p>
            {categories.length === 0 ? (
              <p class="jnav-dd-empty">—</p>
            ) : (
              categories.map((c) => (
                <a
                  href={categoryHref(lang, c.slug)}
                  data-menu-link
                  class="jnl-fullmenu-link jnl-fullmenu-link--sub"
                  aria-current={isActiveNav(categoryHref(lang, c.slug), path) ? "page" : undefined}
                >
                  <span>{c.name}</span>
                  <span class="jnav-dd-count">{c.count}</span>
                </a>
              ))
            )}

            {topTags.length > 0 && (
              <>
                <p class="jnl-fullmenu-sub">{labels.tags}</p>
                <div class="jnav-dd-chips">
                  {topTags.map((t) => (
                    <a
                      href={tagHref(lang, t.name)}
                      data-menu-link
                      class:list={["chip-flat", "chip-flat--sm", { on: isActiveNav(tagHref(lang, t.name), path) }]}
                    >#{t.name}</a>
                  ))}
                </div>
              </>
            )}

            <p class="jnl-fullmenu-sub">{labels.topics}</p>
            <a
              href={topicsHref(lang)}
              data-menu-link
              class="jnl-fullmenu-link jnl-fullmenu-link--sub jnl-fullmenu-link--lead"
              aria-current={isActiveNav(topicsHref(lang), path) ? "page" : undefined}
            >
              <span>{labels.topics}</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        )
      )}
    </nav>

    <div class="jnl-fullmenu-foot max-w-5xl mx-auto w-full">
      <div class="flex items-center gap-2">
        <div class="lang-toggle" role="group" aria-label="Sprache / Language">
          <a href="/" class={lang === "de" ? "on" : ""} aria-current={lang === "de" ? "true" : undefined}>DE</a>
          <a href="/en/" class={lang === "en" ? "on" : ""} aria-current={lang === "en" ? "true" : undefined}>EN</a>
        </div>
        <ThemeToggle client:idle />
      </div>
      <a
        href="https://tracht-digital.de/#contact"
        data-menu-link
        class="btn-flat jnl-fullmenu-cta"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4.5" width="18" height="16" /><path d="M3 9h18M8 2.5v4M16 2.5v4" />
        </svg>
        <span>{cta}</span>
      </a>
    </div>
  </div>
</header>

<style>
  /* Animated hamburger ↔ × — mirrors the landingpage header so the two
     public surfaces feel the same. Three absolutely-positioned bars
     transform on aria-expanded. */
  .jnl-menu-bar {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18px;
    height: 1.75px;
    background-color: currentColor;
    transform-origin: center;
    transform: translate(-50%, -50%);
    transition:
      transform 220ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 180ms ease;
  }
  .jnl-menu-bar-top {
    transform: translate(-50%, calc(-50% - 6px));
  }
  .jnl-menu-bar-bot {
    transform: translate(-50%, calc(-50% + 6px));
  }
  .jnl-menu-toggle[aria-expanded="true"] .jnl-menu-bar-top {
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .jnl-menu-toggle[aria-expanded="true"] .jnl-menu-bar-mid {
    opacity: 0;
    transform: translate(-50%, -50%) scaleX(0.6);
  }
  .jnl-menu-toggle[aria-expanded="true"] .jnl-menu-bar-bot {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  /* Full-screen overlay menu — flat (no glass), solid paper surface so it
     holds in both themes. Fades + lifts in; covers the whole viewport. */
  .jnl-fullmenu {
    position: fixed;
    inset: 0;
    z-index: 50;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: 1rem 1.25rem 1.5rem;
    background: var(--color-paper);
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 220ms ease, transform 220ms ease, visibility 0s linear 220ms;
  }
  .jnl-fullmenu[data-open="true"] {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition: opacity 220ms ease, transform 220ms ease, visibility 0s linear 0s;
  }

  .jnl-fullmenu-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.25rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-line);
  }
  .jnl-fullmenu-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.5rem;
    color: var(--color-primary);
    background: transparent;
    border: 0;
    cursor: pointer;
    transition: background-color 160ms ease;
  }
  .jnl-fullmenu-close:hover {
    background: var(--color-soft);
  }

  .jnl-fullmenu-nav {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 0;
  }
  .jnl-fullmenu-group {
    display: flex;
    flex-direction: column;
  }
  .jnl-fullmenu-sub {
    margin: 1.25rem 0 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* Large editorial links (Instrument Serif); sub-items drop to the body
     font. Flat accent-underline hover, consistent with .jnav-item. */
  .jnl-fullmenu-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 3rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    text-decoration: none;
    transition: color 160ms ease;
  }
  .jnl-fullmenu-link:hover,
  .jnl-fullmenu-link:focus-visible {
    color: var(--color-primary);
  }
  .jnl-fullmenu-link[aria-current="page"] {
    color: var(--color-primary);
  }
  .jnl-fullmenu-link--sub {
    min-height: 2.5rem;
    padding-left: 0.25rem;
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--color-ink);
  }
  .jnl-fullmenu-link--sub[aria-current="page"] {
    font-weight: 600;
  }
  .jnl-fullmenu-link--lead {
    color: var(--color-primary);
  }
  .jnl-fullmenu-nav .jnav-dd-chips {
    padding: 0.25rem 0 0.125rem;
  }

  .jnl-fullmenu-foot {
    margin-top: auto;
    padding-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-top: 1px solid var(--color-line);
  }
  .jnl-fullmenu-cta {
    gap: 0.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .jnl-fullmenu,
    .jnl-menu-bar {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  // Live search — bind the desktop search field (mobile has none).
  const inputs = document.querySelectorAll<HTMLInputElement>(".js-blog-search");
  const initialQ = new URLSearchParams(location.search).get("q");
  inputs.forEach((input) => {
    if (initialQ) input.value = initialQ;

    input.addEventListener("input", () => {
      if (document.documentElement.dataset.blogLiveSearch) {
        document.dispatchEvent(new CustomEvent("tds-blog-search", { detail: input.value }));
      }
    });
    input.addEventListener("keydown", (e) => {
      if (e.key !== "Enter") return;
      if (document.documentElement.dataset.blogLiveSearch) return; // island filters live
      const target = input.dataset.indexUrl || "/";
      if (input.value.trim()) {
        location.href = `${target}?q=${encodeURIComponent(input.value.trim())}`;
      }
    });
  });

  // Desktop "Entdecken" disclosure — a flat panel under the nav button.
  // Toggles on click; closes on Escape, click-outside or a route change.
  const ddRoot = document.getElementById("jnl-entdecken");
  const ddBtn = document.getElementById("jnl-entdecken-btn");
  const ddPanel = document.getElementById("jnl-entdecken-panel");
  if (ddRoot && ddBtn && ddPanel) {
    const setDd = (open: boolean) => {
      ddBtn.setAttribute("aria-expanded", open ? "true" : "false");
      ddPanel.dataset.open = open ? "true" : "false";
    };
    ddBtn.addEventListener("click", () => {
      setDd(ddBtn.getAttribute("aria-expanded") !== "true");
    });
    document.addEventListener("click", (e) => {
      if (!ddRoot.contains(e.target as Node)) setDd(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && ddBtn.getAttribute("aria-expanded") === "true") {
        setDd(false);
        ddBtn.focus();
      }
    });
  }

  // Mobile chrome — the full-screen overlay menu. Open locks body scroll.
  const menuToggle = document.getElementById("jnl-menu-toggle");
  const menu = document.getElementById("jnl-mobile-menu");
  const menuClose = document.getElementById("jnl-menu-close");

  if (menuToggle && menu) {
    const setMenu = (open: boolean) => {
      menuToggle.setAttribute("aria-expanded", open ? "true" : "false");
      menu.dataset.open = open ? "true" : "false";
      menu.setAttribute("aria-hidden", open ? "false" : "true");
      document.body.classList.toggle("drawer-open", open);
      if (open) requestAnimationFrame(() => menuClose?.focus()); // wait for visibility flip
    };

    menuToggle.addEventListener("click", () => {
      const open = menuToggle.getAttribute("aria-expanded") !== "true";
      setMenu(open);
      if (!open) menuToggle.focus();
    });
    menuClose?.addEventListener("click", () => {
      setMenu(false);
      menuToggle.focus();
    });
    menu.querySelectorAll<HTMLAnchorElement>("[data-menu-link]").forEach((link) => {
      link.addEventListener("click", () => setMenu(false));
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.dataset.open === "true") {
        setMenu(false);
        menuToggle.focus();
      }
    });

    // Close when crossing into the desktop (md / 768px) nav.
    const mq = window.matchMedia("(min-width: 768px)");
    mq.addEventListener("change", (e) => {
      if (e.matches) setMenu(false);
    });
  }
</script>
