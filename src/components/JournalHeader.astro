---
/**
 * Flat top nav from the design-system blog kit: logomark + wordmark,
 * bordeaux divider square, angular nav items, live search field,
 * DE/EN segmented toggle and the primary CTA.
 *
 * The primary nav is Journal · Entdecken ▾. "Entdecken" opens a flat
 * disclosure panel grouping the corpus into Kategorien · Beliebte Tags ·
 * Aktuelle Themen (all built from `getTaxonomy()` at build time).
 *
 * Below `lg` the bar carries just the logo + a hamburger, which opens the
 * shared `.tds-mobile-menu` sheet docked under the bar (large editorial
 * links, the Entdecken group expanded inline). The mechanics come from
 * `tds-shared/nav`; the sheet replaced a bespoke full-screen overlay and
 * the breakpoint moved from `md` to `lg`, so all three public sites now
 * hide their desktop nav at the same width. Search stays desktop-only.
 *
 * The desktop search field drives the BlogIndex island when one is on the
 * page (CustomEvent `tds-blog-search`, flagged via `data-blog-live-search`
 * on <html>); everywhere else Enter navigates to the index with `?q=`.
 * It carries `role="search"` so the one search affordance on the site is
 * reachable as a landmark — on the index it filters the grid in place, so a
 * screen-reader user has no other way back to it.
 *
 * "Entdecken" is a DISCLOSURE, not a menu. It deliberately carries no
 * `aria-haspopup`: the panel it opens is a `role="group"`, and announcing a
 * menu that never arrives leaves a screen-reader user waiting for arrow-key
 * navigation this control does not implement. `aria-expanded` plus
 * `aria-controls` is the whole pattern.
 */
import { AccountMenu, ThemeToggle } from "@tracht-digital-solutions/tds-shared/components";
import {
  primaryNav,
  isActiveNav,
  isEntdeckenActive,
  entdeckenLabels,
  categoryHref,
  tagHref,
  topicsHref,
} from "~/lib/nav";
import { getTaxonomy } from "~/lib/taxonomy";

interface Props {
  lang?: "de" | "en";
  class?: string;
}

const { lang = "de", class: className } = Astro.props;

const home = lang === "de" ? "/" : "/en/";
const nav = primaryNav(lang);
const path = Astro.url.pathname;
const labels = entdeckenLabels(lang);
const { categories, topTags } = await getTaxonomy(lang);
const entdeckenActive = isEntdeckenActive(path);
const searchPlaceholder = lang === "de" ? "Suchen …" : "Search …";
// The canonical call, shared with the landingpage and the tools site
// (tds-shared translations: hero.cta1 / footer.primaryCta). "Termin
// vereinbaren" promised a scheduled appointment nobody offers — the
// website deliberately makes no consultation promise at all.
const cta = lang === "de" ? "Unverbindlich anfragen" : "Get in touch";
const menuLabel = lang === "en" ? "Menu" : "Menü";
---

<header class:list={["brand-header", className]}>
  <div class="tds-shell min-h-15 py-2.5 flex flex-nowrap items-center gap-x-2 sm:gap-x-4">
    <a
      href={home}
      aria-label="Tracht Journal"
      class="brand-wordmark text-[0.9375rem] sm:text-[1.0625rem] tracking-tight shrink-0 whitespace-nowrap inline-flex items-center gap-1.5 sm:gap-2"
    >
      <span class="brand-logo" aria-hidden="true"></span>
      <span class="accent-italic">Journal</span>
    </a>
    <span class="nav-divider hidden sm:block" aria-hidden="true"></span>

    <nav class="hidden lg:flex items-center gap-1 flex-1 min-w-0" aria-label="Navigation">
      {nav.map((node) =>
        node.kind === "link" ? (
          <a
            href={node.href}
            class="jnav-item whitespace-nowrap"
            aria-current={isActiveNav(node.href, path) ? "page" : undefined}
          >
            {node.label}
          </a>
        ) : (
          <div class="jnav-dd" id="jnl-entdecken">
            <button
              type="button"
              id="jnl-entdecken-btn"
              class="jnav-item jnav-dd-btn whitespace-nowrap"
              aria-expanded="false"
              aria-controls="jnl-entdecken-panel"
              aria-current={entdeckenActive ? "true" : undefined}
            >
              <span>{node.label}</span>
              <svg class="jnav-dd-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
            </button>
            <div id="jnl-entdecken-panel" class="jnav-dropdown" data-open="false" role="group" aria-label={node.label}>
              <div class="jnav-dd-col">
                <p class="jnav-dd-head">{labels.categories}</p>
                {categories.length === 0 ? (
                  <p class="jnav-dd-empty">—</p>
                ) : (
                  <div class="jnav-dd-links">
                    {categories.map((c) => (
                      <a href={categoryHref(lang, c.slug)} class="jnav-dd-link">
                        <span>{c.name}</span>
                        <span class="jnav-dd-count">{c.count}</span>
                      </a>
                    ))}
                  </div>
                )}
              </div>
              <div class="jnav-dd-col">
                <p class="jnav-dd-head">{labels.tags}</p>
                {topTags.length === 0 ? (
                  <p class="jnav-dd-empty">—</p>
                ) : (
                  <div class="jnav-dd-chips">
                    {topTags.map((t) => (
                      <a href={tagHref(lang, t.name)} class="chip-flat chip-flat--sm">#{t.name}</a>
                    ))}
                  </div>
                )}
              </div>
              <div class="jnav-dd-col">
                <p class="jnav-dd-head">{labels.topics}</p>
                <a href={topicsHref(lang)} class="jnav-dd-link jnav-dd-link--lead">
                  <span>{labels.topics}</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </div>
        )
      )}
    </nav>

    <div class="nav-search hidden lg:flex" role="search">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M10.8 10.8L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
      <input
        type="search"
        id="jnl-search"
        class="js-blog-search"
        placeholder={searchPlaceholder}
        aria-label={searchPlaceholder}
        data-index-url={home}
      />
    </div>

    {/* Push the mobile controls to the right (the desktop nav already takes
        the flex space from lg up). */}
    <div class="flex-1 lg:hidden"></div>

    {/* Right-hand controls. Language, theme and the CTA only show from lg
        up; below that they live in the panel and just the hamburger remains. */}
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <div class="hidden lg:flex items-center gap-2">
        <div class="tds-lang-toggle" role="group" aria-label="Sprache / Language">
          <a href="/" class={lang === "de" ? "on" : ""} aria-current={lang === "de" ? "true" : undefined}>DE</a>
          <a href="/en/" class={lang === "en" ? "on" : ""} aria-current={lang === "en" ? "true" : undefined}>EN</a>
        </div>

        <ThemeToggle
          client:idle
          labelToDark={lang === "en" ? "Switch to dark mode" : "Auf Dunkel umschalten"}
          labelToLight={lang === "en" ? "Switch to light mode" : "Auf Hell umschalten"}
        />

        <a href="https://tracht-digital.de/#contact" class="btn-flat" style="height: 2.25rem;">
          {cta}
        </a>
      </div>

      {/* Outside the `hidden lg:flex` block on purpose: who you are is not
          desktop chrome, and below `lg` this is the only thing beside the
          hamburger. It renders NOTHING for a signed-out reader — the blog is
          public and a login CTA next to the contact button would be noise —
          so an anonymous visitor sees the header exactly as before.

          Utilities ride on this wrapper, never on the island: tds-shared's CSS
          is unlayered while Tailwind's utilities sit in `@layer utilities`, so
          a class on `.tds-dropdown` itself would lose. */}
      <div class="flex items-center">
        <AccountMenu client:idle lang={lang} />
      </div>

      <button
        id="jnl-menu-toggle"
        type="button"
        class="btn btn-ghost tds-menu-toggle"
        aria-controls="jnl-mobile-menu"
        aria-expanded="false"
        aria-label={menuLabel}
      >
        <span class="tds-menu-bar tds-menu-bar-top" aria-hidden="true"></span>
        <span class="tds-menu-bar tds-menu-bar-mid" aria-hidden="true"></span>
        <span class="tds-menu-bar tds-menu-bar-bot" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  {/* The docked sheet is `.tds-mobile-menu` (tds-shared) — the same panel the
      landingpage and the tools site open, so the sheet, its motion, its scroll
      containment and the breakpoint are all shared. It used to be a bespoke
      full-screen overlay at `md`, which is the divergence this replaces.

      Only the docking offset stays here, matched to the header's `min-h-15`
      (3.75rem) and published as `--tds-mobile-menu-inset` so the panel's
      max-height stops at the viewport edge. The journal's own editorial link
      optics (`.jnl-fullmenu-*`) stay too — the surface keeps its voice, only
      the mechanics converge.

      The overlay's own head is gone: it carried a wordmark already visible in
      the sticky bar above the sheet, and a close button the hamburger — now an
      × — already is. */}
  <div
    id="jnl-mobile-menu"
    class="tds-mobile-menu inset-x-0 top-[3.75rem]"
    style="--tds-mobile-menu-inset: 3.75rem"
    data-open="false"
    aria-hidden="true"
    aria-label={menuLabel}
  >
    <nav class="jnl-fullmenu-nav mx-auto w-full" aria-label="Navigation">
      {nav.map((node) =>
        node.kind === "link" ? (
          <a
            href={node.href}
            data-menu-link
            class="jnl-fullmenu-link"
            aria-current={isActiveNav(node.href, path) ? "page" : undefined}
          >
            {node.label}
          </a>
        ) : (
          <div class="jnl-fullmenu-group">
            <p class="jnl-fullmenu-sub">{labels.categories}</p>
            {categories.length === 0 ? (
              <p class="jnav-dd-empty">—</p>
            ) : (
              categories.map((c) => (
                <a
                  href={categoryHref(lang, c.slug)}
                  data-menu-link
                  class="jnl-fullmenu-link jnl-fullmenu-link--sub"
                  aria-current={isActiveNav(categoryHref(lang, c.slug), path) ? "page" : undefined}
                >
                  <span>{c.name}</span>
                  <span class="jnav-dd-count">{c.count}</span>
                </a>
              ))
            )}

            {topTags.length > 0 && (
              <>
                <p class="jnl-fullmenu-sub">{labels.tags}</p>
                <div class="jnav-dd-chips">
                  {topTags.map((t) => (
                    <a
                      href={tagHref(lang, t.name)}
                      data-menu-link
                      class:list={["chip-flat", "chip-flat--sm", { on: isActiveNav(tagHref(lang, t.name), path) }]}
                    >#{t.name}</a>
                  ))}
                </div>
              </>
            )}

            <p class="jnl-fullmenu-sub">{labels.topics}</p>
            <a
              href={topicsHref(lang)}
              data-menu-link
              class="jnl-fullmenu-link jnl-fullmenu-link--sub jnl-fullmenu-link--lead"
              aria-current={isActiveNav(topicsHref(lang), path) ? "page" : undefined}
            >
              <span>{labels.topics}</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        )
      )}
    </nav>

    <div class="jnl-fullmenu-foot mx-auto w-full">
      <div class="flex items-center gap-2">
        <div class="tds-lang-toggle" role="group" aria-label="Sprache / Language">
          <a href="/" class={lang === "de" ? "on" : ""} aria-current={lang === "de" ? "true" : undefined}>DE</a>
          <a href="/en/" class={lang === "en" ? "on" : ""} aria-current={lang === "en" ? "true" : undefined}>EN</a>
        </div>
        <ThemeToggle
          client:idle
          labelToDark={lang === "en" ? "Switch to dark mode" : "Auf Dunkel umschalten"}
          labelToLight={lang === "en" ? "Switch to light mode" : "Auf Hell umschalten"}
        />
      </div>
      <a
        href="https://tracht-digital.de/#contact"
        data-menu-link
        class="btn-flat jnl-fullmenu-cta"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4.5" width="18" height="16" /><path d="M3 9h18M8 2.5v4M16 2.5v4" />
        </svg>
        <span>{cta}</span>
      </a>
    </div>
  </div>
</header>

<style>
  /* The animated hamburger ↔ × bars are `.tds-menu-bar*` from tds-shared
     primitives.css — this block and the landingpage's were the same rules
     under two names. The bars stay square here because
     `[data-surface="blog"]` sets `--tds-radius-bar: 0`, which is the one
     thing that actually differed. */

  /* The panel container is `.tds-mobile-menu` (tds-shared 0.25.0). What used
     to be here — a `position: fixed; inset: 0` full-screen sheet with its own
     fade, its own `overscroll-behavior` and its own reduced-motion rule — was
     the blog's private answer to a problem three sites have. The rules below
     are what stayed: the journal's editorial link optics, which ARE surface
     voice and deliberately did not converge. */

  .jnl-fullmenu-nav {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 0;
  }
  .jnl-fullmenu-group {
    display: flex;
    flex-direction: column;
  }
  .jnl-fullmenu-sub {
    margin: 1.25rem 0 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* Large editorial links (display grotesk); sub-items drop to the body
     font. Flat accent-underline hover, consistent with .jnav-item. */
  .jnl-fullmenu-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 3rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    text-decoration: none;
    transition: color 160ms ease;
  }
  .jnl-fullmenu-link:hover,
  .jnl-fullmenu-link:focus-visible {
    color: var(--color-primary);
  }
  .jnl-fullmenu-link[aria-current="page"] {
    color: var(--color-primary);
  }
  .jnl-fullmenu-link--sub {
    min-height: 2.5rem;
    padding-left: 0.25rem;
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--color-ink);
  }
  .jnl-fullmenu-link--sub[aria-current="page"] {
    font-weight: 600;
  }
  .jnl-fullmenu-link--lead {
    color: var(--color-primary);
  }
  .jnl-fullmenu-nav .jnav-dd-chips {
    padding: 0.25rem 0 0.125rem;
  }

  .jnl-fullmenu-foot {
    padding-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-top: 1px solid var(--color-line);
  }
  .jnl-fullmenu-cta {
    gap: 0.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .jnl-fullmenu-link {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  // NOT `is:inline` — an inline script is not bundled, so this import would
  // reach the browser as a bare specifier.
  import { mountMobileNav } from "@tracht-digital-solutions/tds-shared/nav";

  // Live search — bind the desktop search field (mobile has none).
  const inputs = document.querySelectorAll<HTMLInputElement>(".js-blog-search");
  const initialQ = new URLSearchParams(location.search).get("q");
  inputs.forEach((input) => {
    if (initialQ) input.value = initialQ;

    input.addEventListener("input", () => {
      if (document.documentElement.dataset.blogLiveSearch) {
        document.dispatchEvent(new CustomEvent("tds-blog-search", { detail: input.value }));
      }
    });
    input.addEventListener("keydown", (e) => {
      if (e.key !== "Enter") return;
      if (document.documentElement.dataset.blogLiveSearch) return; // island filters live
      const target = input.dataset.indexUrl || "/";
      if (input.value.trim()) {
        location.href = `${target}?q=${encodeURIComponent(input.value.trim())}`;
      }
    });
  });

  // Desktop "Entdecken" disclosure — a flat panel under the nav button.
  // Toggles on click; closes on Escape, click-outside or a route change.
  const ddRoot = document.getElementById("jnl-entdecken");
  const ddBtn = document.getElementById("jnl-entdecken-btn");
  const ddPanel = document.getElementById("jnl-entdecken-panel");
  if (ddRoot && ddBtn && ddPanel) {
    const setDd = (open: boolean) => {
      ddBtn.setAttribute("aria-expanded", open ? "true" : "false");
      ddPanel.dataset.open = open ? "true" : "false";
    };
    ddBtn.addEventListener("click", () => {
      setDd(ddBtn.getAttribute("aria-expanded") !== "true");
    });
    document.addEventListener("click", (e) => {
      if (!ddRoot.contains(e.target as Node)) setDd(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && ddBtn.getAttribute("aria-expanded") === "true") {
        setDd(false);
        ddBtn.focus();
      }
    });
  }

  // Mobile chrome. The mechanics are shared (tds-shared 0.25.0): this file
  // used to carry its own scroll lock (`body.drawer-open`), its own Escape
  // handler and its own `768px` matchMedia — three details that had to agree
  // with the landingpage's and did not. It gains an outside-click close and a
  // Tab trap it never had; it keeps the focus handling it already did well,
  // because the shared version was built from it.
  const menuToggle = document.getElementById("jnl-menu-toggle");
  const menu = document.getElementById("jnl-mobile-menu");
  if (menuToggle && menu) {
    mountMobileNav({ toggle: menuToggle, panel: menu });
  }
</script>
