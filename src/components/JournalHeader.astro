---
/**
 * Slim editorial header for the public journal. Wordmark on the left
 * doubles as the back-to-main-site link; the right slot points at
 * the rest of the brand surface (main site, customer portal, RSS).
 */
import { ThemeToggle } from "@tracht-digital-solutions/tds-shared/components";

const items = [
  { label: "Hauptseite", href: "https://tracht-digital.de" },
  { label: "Themen", href: "/#themen" },
  { label: "Kundenportal", href: "https://app.tracht-digital.de" },
  { label: "RSS", href: "/rss.xml" },
];
---

<header class="brand-header">
  <div class="max-w-5xl mx-auto px-6 min-h-16 py-2.5 flex flex-wrap items-center justify-between gap-x-6 gap-y-1">
    <a href="/" class="brand-wordmark text-[1.0625rem] tracking-tight">
      Tracht <span class="accent-italic">Journal</span>
    </a>

    <nav class="flex items-center gap-x-4 gap-y-1 text-sm flex-wrap">
      {items.map((it) => (
        <a
          href={it.href}
          class="link-underline text-[var(--color-muted)] hover:text-[var(--color-ink)] transition-colors"
        >
          {it.label}
        </a>
      ))}
      <ThemeToggle client:load />
    </nav>
  </div>
</header>
