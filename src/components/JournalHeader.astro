---
/**
 * Flat top nav from the design-system blog kit: logomark + wordmark,
 * bordeaux divider square, angular nav items, live search field,
 * DE/EN segmented toggle and the primary CTA.
 *
 * The primary nav is Journal · Entdecken ▾ · RSS. "Entdecken" opens a flat
 * disclosure panel grouping the corpus into Kategorien · Beliebte Tags ·
 * Aktuelle Themen (all built from `getTaxonomy()` at build time). Below
 * `md` it collapses — with the search and CTA — into the slide-down drawer,
 * where Entdecken becomes an accordion instead of a hover panel.
 *
 * The search field drives the BlogIndex island when one is on the page
 * (CustomEvent `tds-blog-search`, flagged via `data-blog-live-search` on
 * <html>); everywhere else Enter navigates to the index with `?q=`.
 */
import { ThemeToggle } from "@tracht-digital-solutions/tds-shared/components";
import {
  primaryNav,
  isActiveNav,
  isEntdeckenActive,
  entdeckenLabels,
  categoryHref,
  tagHref,
  topicsHref,
} from "~/lib/nav";
import { getTaxonomy } from "~/lib/taxonomy";

interface Props {
  lang?: "de" | "en";
  class?: string;
}

const { lang = "de", class: className } = Astro.props;

const home = lang === "de" ? "/" : "/en/";
const nav = primaryNav(lang);
const path = Astro.url.pathname;
const labels = entdeckenLabels(lang);
const { categories, topTags } = await getTaxonomy(lang);
const entdeckenActive = isEntdeckenActive(path);
const searchPlaceholder = lang === "de" ? "Suchen …" : "Search …";
const cta = lang === "de" ? "Termin vereinbaren" : "Book a meeting";
const menuLabel = lang === "en" ? "Menu" : "Menü";
const closeLabel = lang === "en" ? "Close menu" : "Menü schließen";

// Flat stroke glyphs for the drawer nav, keyed by nav item. Inline SVG
// paths (no icon dependency) matching the angular blog kit.
const navIcons: Record<string, string> = {
  journal:
    '<path d="M3 4.5h6a2.5 2.5 0 0 1 2.5 2.5v12.5a2 2 0 0 0-2-2H3z"/><path d="M21 4.5h-6A2.5 2.5 0 0 0 12.5 7v12.5a2 2 0 0 1 2-2H21z"/>',
  entdecken:
    '<circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/>',
  rss: '<path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.4"/>',
};
---

<header class:list={["brand-header", className]}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 min-h-15 py-2.5 flex flex-nowrap items-center gap-x-2 sm:gap-x-4">
    <a
      href={home}
      aria-label="Tracht Journal"
      class="brand-wordmark text-[0.9375rem] sm:text-[1.0625rem] tracking-tight shrink-0 whitespace-nowrap inline-flex items-center gap-1.5 sm:gap-2"
    >
      <span class="brand-logo" aria-hidden="true"></span>
      <span class="accent-italic">Journal</span>
    </a>
    <span class="nav-divider hidden sm:block" aria-hidden="true"></span>

    <nav class="hidden md:flex items-center gap-1 flex-1 min-w-0" aria-label="Navigation">
      {nav.map((node) =>
        node.kind === "link" ? (
          <a
            href={node.href}
            class="jnav-item whitespace-nowrap"
            aria-current={isActiveNav(node.href, path) ? "page" : undefined}
          >
            {node.label}
          </a>
        ) : (
          <div class="jnav-dd" id="jnl-entdecken">
            <button
              type="button"
              id="jnl-entdecken-btn"
              class="jnav-item jnav-dd-btn whitespace-nowrap"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="jnl-entdecken-panel"
              aria-current={entdeckenActive ? "true" : undefined}
            >
              <span>{node.label}</span>
              <svg class="jnav-dd-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
            </button>
            <div id="jnl-entdecken-panel" class="jnav-dropdown" data-open="false" role="group" aria-label={node.label}>
              <div class="jnav-dd-col">
                <p class="jnav-dd-head">{labels.categories}</p>
                {categories.length === 0 ? (
                  <p class="jnav-dd-empty">—</p>
                ) : (
                  <div class="jnav-dd-links">
                    {categories.map((c) => (
                      <a href={categoryHref(lang, c.slug)} class="jnav-dd-link">
                        <span>{c.name}</span>
                        <span class="jnav-dd-count">{c.count}</span>
                      </a>
                    ))}
                  </div>
                )}
              </div>
              <div class="jnav-dd-col">
                <p class="jnav-dd-head">{labels.tags}</p>
                {topTags.length === 0 ? (
                  <p class="jnav-dd-empty">—</p>
                ) : (
                  <div class="jnav-dd-chips">
                    {topTags.map((t) => (
                      <a href={tagHref(lang, t.name)} class="chip-flat chip-flat--sm">#{t.name}</a>
                    ))}
                  </div>
                )}
              </div>
              <div class="jnav-dd-col">
                <p class="jnav-dd-head">{labels.topics}</p>
                <a href={topicsHref(lang)} class="jnav-dd-link jnav-dd-link--lead">
                  <span>{labels.topics}</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </div>
        )
      )}
    </nav>

    <div class="nav-search hidden md:flex">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M10.8 10.8L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
      <input
        type="search"
        id="jnl-search"
        class="js-blog-search"
        placeholder={searchPlaceholder}
        aria-label={searchPlaceholder}
        data-index-url={home}
      />
    </div>

    {/* Mobile search bar — on phones the only bar controls are this field
        and the hamburger; language + theme live inside the panel. */}
    <div class="nav-search nav-search--block md:hidden flex-1 min-w-0">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M10.8 10.8L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
      <input
        type="search"
        id="jnl-search-bar"
        class="js-blog-search"
        placeholder={searchPlaceholder}
        aria-label={searchPlaceholder}
        data-index-url={home}
      />
    </div>

    {/* Right-hand controls. Language, theme and the CTA only show from md
        up; on mobile just the hamburger remains. */}
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <div class="hidden md:flex items-center gap-2">
        <div class="lang-toggle" role="group" aria-label="Sprache / Language">
          <a href="/" class={lang === "de" ? "on" : ""} aria-current={lang === "de" ? "true" : undefined}>DE</a>
          <a href="/en/" class={lang === "en" ? "on" : ""} aria-current={lang === "en" ? "true" : undefined}>EN</a>
        </div>

        <ThemeToggle client:idle />

        <a href="https://tracht-digital.de/#contact" class="btn-flat" style="height: 2.25rem;">
          {cta}
        </a>
      </div>

      <button
        id="jnl-menu-toggle"
        type="button"
        class="jnl-menu-toggle md:hidden relative inline-flex items-center justify-center w-11 h-11 text-[var(--color-primary)] hover:bg-[var(--color-soft)] transition-colors cursor-pointer"
        aria-controls="jnl-mobile-menu"
        aria-expanded="false"
        aria-label={menuLabel}
      >
        <span class="jnl-menu-bar jnl-menu-bar-top" aria-hidden="true"></span>
        <span class="jnl-menu-bar jnl-menu-bar-mid" aria-hidden="true"></span>
        <span class="jnl-menu-bar jnl-menu-bar-bot" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  {/* Dimmed backdrop behind the drawer (mobile only). */}
  <div id="jnl-overlay" class="jnl-overlay md:hidden" hidden></div>

  {/* Mobile drawer — flat off-canvas panel sliding in from the right,
      holding the links, language/theme controls and CTA kept off the
      bar below md. Entdecken is an accordion here, not a hover panel. */}
  <aside
    id="jnl-mobile-menu"
    class="jnl-drawer md:hidden"
    aria-hidden="true"
    aria-label={menuLabel}
  >
    <div class="jnl-drawer-head">
      <span class="brand-wordmark inline-flex items-center gap-2 text-[1.0625rem] tracking-tight">
        <span class="brand-logo" aria-hidden="true"></span>
        <span class="accent-italic">Journal</span>
      </span>
      <button
        id="jnl-menu-close"
        type="button"
        class="jnl-drawer-close"
        aria-label={closeLabel}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <nav class="jnl-drawer-nav" aria-label="Navigation">
      {nav.map((node) =>
        node.kind === "link" ? (
          <a
            href={node.href}
            data-menu-link
            class="jnav-item jnav-item--block"
            aria-current={isActiveNav(node.href, path) ? "page" : undefined}
          >
            <svg class="jnav-ico" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={navIcons[node.key]} />
            <span>{node.label}</span>
          </a>
        ) : (
          <div class="jnl-acc">
            <button
              type="button"
              class="jnav-item jnav-item--block jnl-acc-btn"
              aria-expanded={entdeckenActive ? "true" : "false"}
              aria-controls="jnl-acc-panel"
            >
              <svg class="jnav-ico" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={navIcons.entdecken} />
              <span>{node.label}</span>
              <svg class="jnl-acc-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
            </button>
            <div id="jnl-acc-panel" class="jnl-acc-panel" data-open={entdeckenActive ? "true" : "false"}>
              <p class="jnav-dd-head">{labels.categories}</p>
              {categories.length === 0 ? (
                <p class="jnav-dd-empty">—</p>
              ) : (
                categories.map((c) => (
                  <a href={categoryHref(lang, c.slug)} data-menu-link class="jnl-acc-link">
                    <span>{c.name}</span>
                    <span class="jnav-dd-count">{c.count}</span>
                  </a>
                ))
              )}

              <p class="jnav-dd-head">{labels.tags}</p>
              {topTags.length === 0 ? (
                <p class="jnav-dd-empty">—</p>
              ) : (
                <div class="jnav-dd-chips">
                  {topTags.map((t) => (
                    <a href={tagHref(lang, t.name)} data-menu-link class="chip-flat chip-flat--sm">#{t.name}</a>
                  ))}
                </div>
              )}

              <p class="jnav-dd-head">{labels.topics}</p>
              <a href={topicsHref(lang)} data-menu-link class="jnl-acc-link jnl-acc-link--lead">
                <span>{labels.topics}</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        )
      )}
    </nav>

    <div class="jnl-drawer-controls">
      <div class="lang-toggle" role="group" aria-label="Sprache / Language">
        <a href="/" class={lang === "de" ? "on" : ""} aria-current={lang === "de" ? "true" : undefined}>DE</a>
        <a href="/en/" class={lang === "en" ? "on" : ""} aria-current={lang === "en" ? "true" : undefined}>EN</a>
      </div>
      <ThemeToggle client:idle />
    </div>

    <a
      href="https://tracht-digital.de/#contact"
      data-menu-link
      class="btn-flat jnl-drawer-cta w-full justify-center"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="4.5" width="18" height="16" /><path d="M3 9h18M8 2.5v4M16 2.5v4" />
      </svg>
      <span>{cta}</span>
    </a>
  </aside>
</header>

<style>
  /* Animated hamburger ↔ × — mirrors the landingpage header so the two
     public surfaces feel the same. Three absolutely-positioned bars
     transform on aria-expanded. */
  .jnl-menu-bar {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18px;
    height: 1.75px;
    background-color: currentColor;
    transform-origin: center;
    transform: translate(-50%, -50%);
    transition:
      transform 220ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 180ms ease;
  }
  .jnl-menu-bar-top {
    transform: translate(-50%, calc(-50% - 6px));
  }
  .jnl-menu-bar-bot {
    transform: translate(-50%, calc(-50% + 6px));
  }
  .jnl-menu-toggle[aria-expanded="true"] .jnl-menu-bar-top {
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .jnl-menu-toggle[aria-expanded="true"] .jnl-menu-bar-mid {
    opacity: 0;
    transform: translate(-50%, -50%) scaleX(0.6);
  }
  .jnl-menu-toggle[aria-expanded="true"] .jnl-menu-bar-bot {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  /* Dimmed backdrop behind the drawer. */
  .jnl-overlay {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--color-surface-ink) 55%, transparent);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms ease;
  }
  .jnl-overlay[data-open="true"] {
    opacity: 1;
    pointer-events: auto;
  }

  /* Off-canvas drawer — flat panel sliding in from the right. Angular
     (no radii, no shadow), separated by a single left hairline. */
  .jnl-drawer {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 41;
    display: flex;
    flex-direction: column;
    width: min(20rem, 86vw);
    height: 100dvh;
    padding: 1rem 1.25rem 1.5rem;
    background: var(--color-paper);
    border-left: 1px solid var(--color-line);
    transform: translateX(100%);
    transition: transform 260ms cubic-bezier(0.4, 0, 0.2, 1);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .jnl-drawer[data-open="true"] {
    transform: translateX(0);
  }

  .jnl-drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.25rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-line);
  }
  .jnl-drawer-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-right: -0.5rem;
    color: var(--color-primary);
    background: transparent;
    border: 0;
    cursor: pointer;
    transition: background-color 160ms ease;
  }
  .jnl-drawer-close:hover {
    background: var(--color-soft);
  }

  .jnl-drawer-nav {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0;
  }
  .jnl-drawer-controls {
    margin-top: auto;
    padding-top: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-top: 1px solid var(--color-line);
  }
  .jnl-drawer-cta {
    margin-top: 1rem;
    gap: 0.5rem;
  }

  /* Block nav items inside the drawer carry a leading flat glyph. */
  .jnav-item--block {
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1rem;
  }
  .jnav-ico {
    flex-shrink: 0;
    color: var(--color-accent);
    opacity: 0.85;
  }

  /* Full-width variant of the bar search for use on the mobile bar. */
  .nav-search--block {
    display: flex;
    width: 100%;
  }
  .nav-search--block input {
    width: 100%;
  }
  .nav-search--block input:focus {
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .jnl-drawer,
    .jnl-overlay,
    .jnl-menu-bar {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  // Live search — bind to every search field (desktop bar + mobile
  // panel) so the behaviour is identical wherever the visitor types.
  const inputs = document.querySelectorAll<HTMLInputElement>(".js-blog-search");
  const initialQ = new URLSearchParams(location.search).get("q");
  inputs.forEach((input) => {
    if (initialQ) input.value = initialQ;

    input.addEventListener("input", () => {
      if (document.documentElement.dataset.blogLiveSearch) {
        document.dispatchEvent(new CustomEvent("tds-blog-search", { detail: input.value }));
      }
    });
    input.addEventListener("keydown", (e) => {
      if (e.key !== "Enter") return;
      if (document.documentElement.dataset.blogLiveSearch) return; // island filters live
      const target = input.dataset.indexUrl || "/";
      if (input.value.trim()) {
        location.href = `${target}?q=${encodeURIComponent(input.value.trim())}`;
      }
    });
  });

  // Desktop "Entdecken" disclosure — a flat panel under the nav button.
  // Toggles on click; closes on Escape, click-outside or a route change.
  const ddRoot = document.getElementById("jnl-entdecken");
  const ddBtn = document.getElementById("jnl-entdecken-btn");
  const ddPanel = document.getElementById("jnl-entdecken-panel");
  if (ddRoot && ddBtn && ddPanel) {
    const setDd = (open: boolean) => {
      ddBtn.setAttribute("aria-expanded", open ? "true" : "false");
      ddPanel.dataset.open = open ? "true" : "false";
    };
    ddBtn.addEventListener("click", () => {
      setDd(ddBtn.getAttribute("aria-expanded") !== "true");
    });
    document.addEventListener("click", (e) => {
      if (!ddRoot.contains(e.target as Node)) setDd(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && ddBtn.getAttribute("aria-expanded") === "true") {
        setDd(false);
        ddBtn.focus();
      }
    });
  }

  // Mobile drawer toggle — a right-side off-canvas panel with a dimmed
  // overlay and body scroll-lock while open.
  const toggle = document.getElementById("jnl-menu-toggle");
  const menu = document.getElementById("jnl-mobile-menu");
  const overlay = document.getElementById("jnl-overlay");
  const closeBtn = document.getElementById("jnl-menu-close");
  if (toggle && menu && overlay) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      menu.dataset.open = open ? "true" : "false";
      menu.setAttribute("aria-hidden", open ? "false" : "true");
      document.body.classList.toggle("drawer-open", open);
      if (open) {
        overlay.hidden = false;
        overlay.dataset.open = "true";
        closeBtn?.focus();
      } else {
        overlay.dataset.open = "false";
        // Keep the overlay in the DOM through its fade-out, then hide it.
        window.setTimeout(() => {
          if (menu.dataset.open !== "true") overlay.hidden = true;
        }, 240);
      }
    };

    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") !== "true";
      setOpen(open);
      if (!open) toggle.focus();
    });
    closeBtn?.addEventListener("click", () => {
      setOpen(false);
      toggle.focus();
    });
    overlay.addEventListener("click", () => {
      setOpen(false);
      toggle.focus();
    });

    menu.querySelectorAll<HTMLAnchorElement>("[data-menu-link]").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });

    // Close automatically when crossing into the desktop (md / 768px) nav.
    const mq = window.matchMedia("(min-width: 768px)");
    mq.addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });

    // "Entdecken" accordion inside the drawer.
    const accBtn = menu.querySelector<HTMLButtonElement>(".jnl-acc-btn");
    const accPanel = menu.querySelector<HTMLElement>("#jnl-acc-panel");
    if (accBtn && accPanel) {
      accBtn.addEventListener("click", () => {
        const open = accBtn.getAttribute("aria-expanded") !== "true";
        accBtn.setAttribute("aria-expanded", open ? "true" : "false");
        accPanel.dataset.open = open ? "true" : "false";
      });
    }
  }
</script>
