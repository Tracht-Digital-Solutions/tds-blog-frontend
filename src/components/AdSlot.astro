---
/**
 * A single AdSense display unit (manual mode). The `<ins>` is baked at build
 * time; the inline `push` queues it, and the queued unit only renders once the
 * loader script is injected — which the Layout does exclusively after the
 * visitor grants ad consent. So pre-consent this element is inert (no request,
 * no cookie). Neutrally labelled "Anzeige" per AdSense placement policy.
 */
interface Props {
  /** AdSense publisher id (ca-pub-…). */
  client: string;
  /** AdSense ad-unit id (data-ad-slot). */
  slot: string;
  lang?: "de" | "en";
}
const { client, slot, lang = "de" } = Astro.props;
---

<aside class="tds-adslot" aria-label={lang === "de" ? "Werbung" : "Advertisement"}>
  <span class="tds-adslot__label">{lang === "de" ? "Anzeige" : "Advertisement"}</span>
  <ins
    class="adsbygoogle"
    style="display:block"
    data-ad-client={client}
    data-ad-slot={slot}
    data-ad-format="auto"
    data-full-width-responsive="true"></ins>
  <script is:inline>
    (window.adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</aside>

<style>
  .tds-adslot {
    display: block;
    margin: 2rem 0;
    min-height: 90px;
  }
  .tds-adslot__label {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted, #6b6b66);
  }
</style>
