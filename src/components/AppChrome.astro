---
/**
 * The journal on a phone, as an app (since 2026-10-06 with tds-shared 0.49).
 *
 * A bottom tab bar — Start · Entdecken · [Inhalt, on an article] · Mehr — whose
 * non-link tabs open full-screen PAGES (`mountTabPages`): they slide in from
 * the side of their tab, a horizontal swipe moves to the neighbouring tab,
 * Back closes. Below `lg` only; the desktop keeps header and sidebar.
 *
 * "Entdecken" is search and presentation in one: while the field is empty it
 * presents the categories, popular tags and current topics; as soon as the
 * reader types it searches every article (title, excerpt, category, tags) in
 * place. It replaced the separate "Themen" and "Suche" sheets.
 *
 * "Mehr" holds the settings — on an article the reading controls, then theme
 * (icons), language — and the sibling sites as one joined row of buttons.
 */
import { propertyContact, propertyNav } from "@tracht-digital-solutions/tds-shared/nav";
import { entdeckenLabels, categoryHref, tagHref, topicsHref } from "~/lib/nav";
import { getTaxonomy } from "~/lib/taxonomy";
import { corpus } from "~/lib/routes";
import { bookLabel } from "~/lib/book";

interface Props {
  lang: "de" | "en";
  /** The other language's version of this page (or its home). */
  altHref: string;
  /** Article pages: the reading rows (text size, focus, print) in "Mehr". */
  reader?: { printHref: string } | null;
  /** Article pages with ≥2 sections: an "Inhalt" tab. */
  hasToc?: boolean;
}

const { lang, altHref, reader = null, hasToc = false } = Astro.props;
const de = lang === "de";
const home = de ? "/" : "/en/";
const pfx = de ? "" : "/en";
const path = Astro.url.pathname;
const labels = entdeckenLabels(lang);
const { categories, topTags } = await getTaxonomy(lang);
let posts: Awaited<ReturnType<typeof corpus>> = [];
try {
  posts = await corpus(lang);
} catch {
  posts = [];
}
const ordered = [...posts].sort((a, b) => (b.publishedAt ?? "").localeCompare(a.publishedAt ?? ""));
const others = propertyNav("journal", lang, home).filter((p) => !p.current);
const contact = propertyContact(lang);

const t = de
  ? {
      tabs: "App-Navigation", start: "Start", discover: "Entdecken", contents: "Inhalt", more: "Mehr",
      discoverLead: "Suchen oder stöbern – in allen Beiträgen.",
      searchLabel: "Im Journal suchen", searchPh: "Thema, Frage oder Stichwort",
      none: "Kein Beitrag passt dazu.", latest: "Neueste Beiträge",
      contentsLead: "Springe direkt zu einem Kapitel.",
      reading: "Lesen", size: "Textgröße", smaller: "Kleiner", larger: "Größer", focus: "Fokusmodus", print: "Drucken / PDF",
      look: "Darstellung", light: "Hell", dark: "Dunkel", auto: "Auto", language: "Sprache",
      elsewhere: "Mehr von Tracht Digital", cta: "Unverbindlich anfragen",
      count: (n: number) => (n === 1 ? "1 Beitrag" : `${n} Beiträge`),
    }
  : {
      tabs: "App navigation", start: "Home", discover: "Discover", contents: "Contents", more: "More",
      discoverLead: "Search or browse — across every post.",
      searchLabel: "Search the journal", searchPh: "Topic, question or keyword",
      none: "No post matches that.", latest: "Latest posts",
      contentsLead: "Jump straight to a chapter.",
      reading: "Reading", size: "Text size", smaller: "Smaller", larger: "Larger", focus: "Focus mode", print: "Print / PDF",
      look: "Appearance", light: "Light", dark: "Dark", auto: "Auto", language: "Language",
      elsewhere: "More from Tracht Digital", cta: "Get in touch",
      count: (n: number) => (n === 1 ? "1 post" : `${n} posts`),
    };
const deHref = de ? path : altHref;
const enHref = de ? altHref : path;
---

<nav class="tds-tabbar" id="app-tabbar" aria-label={t.tabs}>
  <a class="tds-tabbar__item" href={home} data-tab-match={`${home} ${de ? "/page" : "/en/page"}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"></path><path d="M5 9.5V21h14V9.5"></path><path d="M10 21v-6h4v6"></path></svg>
    <span>{t.start}</span>
  </a>
  <button type="button" class="tds-tabbar__item" data-tab-page="discover" aria-controls="tabpage-discover" aria-expanded="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
    <span>{t.discover}</span>
  </button>
  {hasToc && (
    <button type="button" class="tds-tabbar__item" data-tab-page="toc" aria-controls="tabpage-toc" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13"></path><path d="M3.5 6h.01M3.5 12h.01M3.5 18h.01"></path></svg>
      <span>{t.contents}</span>
    </button>
  )}
  <button type="button" class="tds-tabbar__item" data-tab-page="more" aria-controls="tabpage-more" aria-expanded="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"></path><circle cx="16" cy="7" r="2"></circle><circle cx="10" cy="17" r="2"></circle></svg>
    <span>{t.more}</span>
  </button>
</nav>

<section class="tds-tabpage" id="tabpage-discover" data-tab-page-id="discover" aria-labelledby="tabpage-discover-title" hidden>
  <header class="tds-tabpage__head">
    <h2 id="tabpage-discover-title" tabindex="-1">{t.discover}</h2>
    <p>{t.discoverLead}</p>
  </header>
  <div class="tds-tabpage__body">
    <form class="tds-searchfield" role="search" action={home} method="get">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      <label class="sr-only" for="discover-q">{t.searchLabel}</label>
      <input id="discover-q" class="tds-searchfield__input" name="q" type="search" enterkeyhint="search" autocomplete="off" placeholder={t.searchPh} data-autofocus />
    </form>
    <p class="sr-only" role="status" aria-live="polite" id="discover-status"></p>

    {/* Searching: every article, filtered in place. */}
    <div class="tds-tabpage__section discover-results" id="discover-results" hidden>
      <ul class="discover-list">
        {ordered.map((p) => (
          <li data-search={`${p.title} ${p.excerpt} ${p.category} ${p.tags ?? ""}`.toLowerCase()}>
            <a href={`${pfx}/${p.slug}`} class="discover-hit">
              <span class="discover-hit__meta">{p.category}{bookLabel(p.readingMinutes, lang) ? ` · ${bookLabel(p.readingMinutes, lang)}` : ""}</span>
              <strong>{p.title}</strong>
              <small>{p.excerpt}</small>
            </a>
          </li>
        ))}
      </ul>
      <p class="discover-empty" id="discover-empty" hidden>{t.none}</p>
    </div>

    {/* Not searching: the journal presents itself. */}
    <div id="discover-idle">
      <div class="tds-tabpage__section">
        <p class="tds-sheet-heading">{labels.categories}</p>
        <div class="tds-tilegrid">
          {categories.map((c) => (
            <a class="tds-tile" href={categoryHref(lang, c.slug)}>
              <strong>{c.name}</strong>
              <small>{t.count(c.count)}</small>
            </a>
          ))}
          <a class="tds-tile tile-accent" href={topicsHref(lang)}>
            <strong>{labels.topics}</strong>
            <small>→</small>
          </a>
        </div>
      </div>
      {topTags.length > 0 && (
        <div class="tds-tabpage__section">
          <p class="tds-sheet-heading">{labels.tags}</p>
          <div class="jnav-dd-chips">
            {topTags.map((tag) => (
              <a href={tagHref(lang, tag.name)} class="chip-flat chip-flat--sm">#{tag.name}</a>
            ))}
          </div>
        </div>
      )}
      {ordered.length > 0 && (
        <div class="tds-tabpage__section">
          <p class="tds-sheet-heading">{t.latest}</p>
          <ul class="discover-list">
            {ordered.slice(0, 3).map((p) => (
              <li>
                <a href={`${pfx}/${p.slug}`} class="discover-hit">
                  <span class="discover-hit__meta">{p.category}</span>
                  <strong>{p.title}</strong>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</section>

{hasToc && (
  <section class="tds-tabpage" id="tabpage-toc" data-tab-page-id="toc" aria-labelledby="tabpage-toc-title" hidden>
    <header class="tds-tabpage__head">
      <h2 id="tabpage-toc-title" tabindex="-1">{t.contents}</h2>
      <p>{t.contentsLead}</p>
    </header>
    <div class="tds-tabpage__body">
      {/* Filled from the article's own TOC links on mount — one source. */}
      <ol class="toc-pages" id="tabpage-toc-list"></ol>
    </div>
  </section>
)}

<section class="tds-tabpage" id="tabpage-more" data-tab-page-id="more" aria-labelledby="tabpage-more-title" hidden>
  <header class="tds-tabpage__head">
    <h2 id="tabpage-more-title" tabindex="-1">{t.more}</h2>
  </header>
  <div class="tds-tabpage__body" id="tabpage-more-body">
    {reader && (
      <div class="tds-tabpage__section">
        <p class="tds-sheet-heading">{t.reading}</p>
        <div class="tds-segmented" role="group" aria-label={t.size}>
          <button type="button" class="tds-segmented__option" data-zoom-step="-1" aria-label={t.smaller}>A−</button>
          <button type="button" class="tds-segmented__option" data-zoom-reset aria-label={t.size}><span data-zoom-label>100 %</span></button>
          <button type="button" class="tds-segmented__option" data-zoom-step="1" aria-label={t.larger}>A+</button>
        </div>
        <div class="more-actions">
          <button type="button" class="tds-sheet-row more-row" data-focus-toggle aria-pressed="false">
            <span>{t.focus}</span><span aria-hidden="true" class="more-key">F</span>
          </button>
          <a class="tds-sheet-row more-row" href={reader.printHref} target="_blank" rel="noopener">
            <span>{t.print}</span><span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    )}

    <div class="tds-tabpage__section">
      <p class="tds-sheet-heading">{t.look}</p>
      <div class="tds-segmented tds-segmented--icons" role="group" aria-label={t.look}>
        <button type="button" class="tds-segmented__option" data-theme-choice="light" aria-pressed="false" aria-label={t.light} title={t.light}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        </button>
        <button type="button" class="tds-segmented__option" data-theme-choice="dark" aria-pressed="false" aria-label={t.dark} title={t.dark}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path></svg>
        </button>
        <button type="button" class="tds-segmented__option" data-theme-choice="system" aria-pressed="false" aria-label={t.auto} title={t.auto}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor" stroke="none"></path></svg>
        </button>
      </div>
    </div>

    <div class="tds-tabpage__section">
      <p class="tds-sheet-heading">{t.language}</p>
      <div class="tds-segmented" role="group" aria-label={t.language}>
        <a class="tds-segmented__option" href={deHref} data-locale-link="de" hreflang="de" aria-current={de ? "true" : undefined}>Deutsch</a>
        <a class="tds-segmented__option" href={enHref} data-locale-link="en" hreflang="en" aria-current={!de ? "true" : undefined}>English</a>
      </div>
    </div>

    <div class="tds-tabpage__section">
      <p class="tds-sheet-heading">{t.elsewhere}</p>
      <div class="tds-linkgroup">
        {others.map((p) => <a href={p.href}>{p.label}</a>)}
      </div>
      <a href={contact} class="btn-flat more-cta">{t.cta}</a>
    </div>
  </div>
</section>

<style>
  .discover-results { margin-top: 1.25rem; }
  .discover-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.625rem;
  }
  .discover-hit {
    display: grid;
    gap: 0.25rem;
    padding: 0.875rem 1rem 0.875rem 1.125rem;
    background: var(--color-soft);
    color: var(--color-ink);
    text-decoration: none;
    box-shadow: inset 4px 0 0 var(--color-accent);
  }
  .discover-hit__meta {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .discover-hit strong { font-weight: 700; line-height: 1.25; }
  .discover-hit small {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--color-muted);
    font-size: 0.8125rem;
    line-height: 1.45;
  }
  .discover-empty { margin: 0.75rem 0 0; color: var(--color-muted); }
  .tile-accent { background: var(--color-surface-navy); color: #fff; }
  .tile-accent small { color: rgb(255 255 255 / 0.75); }

  .toc-pages {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: chapter;
  }
  .toc-pages :global(a) {
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
    min-height: 3.25rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: none;
    counter-increment: chapter;
  }
  .toc-pages :global(a)::before {
    content: counter(chapter, decimal-leading-zero);
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .toc-pages :global(a.on) { color: var(--color-primary); }
  .toc-pages :global(a.on)::before { color: var(--color-accent); }

  .more-actions { margin-top: 0.5rem; }
  .more-row {
    width: 100%;
    border-left: 0;
    border-right: 0;
    border-top: 0;
    background: transparent;
    font: inherit;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
  }
  .more-row[aria-pressed="true"] { color: var(--color-accent); }
  .more-key {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .more-cta {
    width: 100%;
    justify-content: center;
    margin-top: 1rem;
  }
</style>

<script>
  import { mountAppTabBar, mountLiveFilter, mountPreferenceControls, mountTabPages } from "@tracht-digital-solutions/tds-shared/app";

  const bar = document.getElementById("app-tabbar");
  if (bar) {
    mountAppTabBar(bar);
    mountTabPages(bar);
  }

  const more = document.getElementById("tabpage-more-body");
  if (more) mountPreferenceControls(more);

  // Entdecken: present while empty, search while typing.
  const q = document.getElementById("discover-q") as HTMLInputElement | null;
  if (q) {
    q.value = new URLSearchParams(location.search).get("q") ?? "";
    const isDe = document.documentElement.lang !== "en";
    mountLiveFilter({
      input: q,
      items: Array.from(document.querySelectorAll<HTMLElement>("#discover-results li[data-search]")),
      idle: document.getElementById("discover-idle"),
      results: document.getElementById("discover-results"),
      empty: document.getElementById("discover-empty"),
      status: document.getElementById("discover-status"),
      countLabel: (n) => (isDe ? `${n} ${n === 1 ? "Beitrag" : "Beiträge"}` : `${n} ${n === 1 ? "post" : "posts"}`),
    });
    // The results are already on the page; Enter only dismisses the keyboard.
    q.form?.addEventListener("submit", (e) => {
      e.preventDefault();
      q.blur();
    });
  }

  // Inhalt: the article's own TOC links, so the chapter list has one source.
  // A chapter that is folded shut opens before the page jumps to it.
  const list = document.getElementById("tabpage-toc-list");
  if (list) {
    for (const link of Array.from(document.querySelectorAll<HTMLAnchorElement>(".toc a[data-toc]"))) {
      const id = link.dataset.toc ?? "";
      const li = document.createElement("li");
      const row = document.createElement("a");
      row.href = `#${id}`;
      row.dataset.toc = id;
      row.textContent = link.querySelector(".toc-label")?.textContent ?? link.textContent ?? "";
      row.addEventListener("click", () => {
        const body = document.getElementById(`${id}-body`);
        if (body?.classList.contains("closed")) {
          body.classList.remove("closed");
          document.querySelector(`#${CSS.escape(id)} .sec-head`)?.setAttribute("aria-expanded", "true");
        }
      });
      li.append(row);
      list.append(li);
    }
    // The chapter being read is marked, mirroring the scroll-spy.
    document.addEventListener("tds:tabpage-open", () => {
      const on = document.querySelector<HTMLAnchorElement>(".toc a.on")?.dataset.toc;
      for (const row of Array.from(list.querySelectorAll<HTMLAnchorElement>("a"))) row.classList.toggle("on", row.dataset.toc === on);
    });
  }
</script>
