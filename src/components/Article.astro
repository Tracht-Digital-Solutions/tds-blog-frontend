---
/**
 * Full article view, shared by the DE (`/[slug]`) and EN (`/en/[slug]`)
 * routes. Receives an already-localized post (authored or machine-
 * translated, see lib/localizedPost.ts) plus the distinct-slug post list
 * for the related/prev-next strips. All in-blog links are prefixed by the
 * current language so DE and EN stay on their own URL space.
 */
import Layout from "~/layouts/Layout.astro";
import RelatedArticles from "~/components/RelatedArticles.astro";
import TagList from "~/components/TagList.astro";
import AdSlot from "~/components/AdSlot.astro";
import BlockRenderer from "~/components/BlockRenderer.astro";
import { adsConfig, effectiveAdsMode, blogSnippets } from "~/lib/content-api";
import { blogPostingSchema, breadcrumbSchema } from "~/lib/jsonld";
import { splitSections } from "~/lib/sections";
import { splitBlockSections } from "~/lib/blockSections";
import { authorHref } from "~/lib/nav";
import { siteConfig } from "~/lib/seo";
import type { LocalizedPost } from "~/lib/localizedPost";
import type { BlogPost } from "@tracht-digital-solutions/tds-shared";

interface Props {
  localized: LocalizedPost;
  lang: "de" | "en";
  /** One entry per distinct slug, for related + prev/next. */
  posts: Array<Pick<BlogPost, "slug" | "lang" | "category" | "title" | "excerpt" | "coverHint" | "tags" | "publishedAt" | "author">>;
}

const { localized, lang, posts } = Astro.props;
const { post, bodyHtml, blocks, translated, sourceLang } = localized;

// Two body formats: a block post carries a parsed `blocks` array (rendered by
// BlockRenderer), a legacy markdown post carries `bodyHtml`.
const isBlocks = blocks != null;
const snippets = isBlocks ? await blogSnippets() : [];

// AdSense: the effective mode for this post (per-post override resolved against
// the global config). `manual` places the AdSlots below; the loader + consent
// gate live in Layout. For block posts the author places ads inline (adsense
// blocks), so the Article-level manual slots only apply to markdown posts.
const ads = await adsConfig();
const adsMode = effectiveAdsMode(post.adsMode, ads);
const showManualAds = adsMode === "manual" && !isBlocks;
const showBlockAds = adsMode !== "off";

const pfx = lang === "en" ? "/en" : "";
const postHref = (slug: string) => `${pfx}/${slug}`;

// Unified section model for the TOC + collapsible bodies. Both formats split at
// level-2 headings; the body of each is rendered format-appropriately below.
const mdSplit = isBlocks ? { intro: "", sections: [] } : splitSections(bodyHtml);
const blkSplit = isBlocks ? splitBlockSections(blocks!) : { intro: [], sections: [] };
const sections = isBlocks
  ? blkSplit.sections.map((s) => ({ id: s.id, heading: s.heading }))
  : mdSplit.sections.map((s) => ({ id: s.id, heading: s.heading }));
const intro = mdSplit.intro;
const showToc = sections.length >= 2;

// Chronological neighbours over the distinct-slug list (every post is
// reachable in this language, authored or translated).
const ordered = [...posts].sort(
  (a, b) => (b.publishedAt ?? "").localeCompare(a.publishedAt ?? ""),
);
const orderedIdx = ordered.findIndex((p) => p.slug === post.slug);
const newerPost = orderedIdx > 0 ? ordered[orderedIdx - 1] : null;
const olderPost =
  orderedIdx >= 0 && orderedIdx < ordered.length - 1 ? ordered[orderedIdx + 1] : null;

const interestTopics = Array.from(
  new Set(
    [post.category, ...(post.tags ?? "").split(",")]
      .map((t) => t.trim().toLowerCase())
      .filter(Boolean),
  ),
);
const explicitCover = post.coverHint?.startsWith("http") ? post.coverHint : undefined;

const dateLabel = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString(lang === "de" ? "de-DE" : "en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;

// Word count from the rendered HTML (markdown) or the block text fields.
const plain = isBlocks
  ? blocks!
      .map((b) => {
        if (b.type === "paragraph" || b.type === "heading" || b.type === "quote" || b.type === "callout") return b.text;
        if (b.type === "list") return b.items.join(" ");
        if (b.type === "code") return b.code;
        return "";
      })
      .join(" ")
  : bodyHtml.replace(/<[^>]+>/g, " ");
const wordCount = plain.split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 220));

const ogImagePath = explicitCover ?? `/og/${lang}/${post.slug}.png`;
const imageUrl = ogImagePath.startsWith("http")
  ? ogImagePath
  : new URL(ogImagePath, siteConfig.url).toString();

const journalLabel = "Journal";
const journalHomeUrl = `${siteConfig.url}${pfx}/`;
const postUrl = new URL(postHref(post.slug), siteConfig.url).toString();

// Contact CTA target: the landingpage's contact form anchor, language-aware
// (the EN landingpage lives under /en/) so EN readers land on the EN form.
const contactUrl = `https://tracht-digital.de${pfx}/#contact`;

const jsonLd = [
  blogPostingSchema({
    slug: post.slug,
    title: post.title,
    excerpt: post.excerpt,
    body: plain,
    category: post.category,
    publishedAt: post.publishedAt,
    updatedAt: post.updatedAt ?? null,
    lang,
    imageUrl,
    wordCount,
  }),
  breadcrumbSchema([
    { name: journalLabel, url: journalHomeUrl },
    { name: post.category, url: journalHomeUrl },
    { name: post.title, url: postUrl },
  ]),
];

const tx = lang === "de"
  ? {
      back: "Alle Beiträge", read: "Min. Lesezeit", contents: "Inhalt",
      tocCollapse: "Inhalt einklappen", tocExpand: "Inhalt ausklappen",
      aboutAuthor: "Über den Autor", owner: "Inhaber, Tracht Digital Solutions",
      bio: "Entwickelt Software, Websites und Digitalisierungslösungen für kleine und mittlere Unternehmen — ansässig in Schwarzenbek bei Hamburg.",
      newer: "Neuerer Artikel", older: "Älterer Artikel", nav: "Artikel-Navigation",
      allArticles: "Alle Artikel", rss: "RSS abonnieren", print: "Drucken",
      machine: "Automatisch übersetzt — das Original ist auf Englisch verfasst.",
      contactHead: "Zusammenarbeiten",
      contactLead: "Ich baue Websites, Webshops und individuelle Lösungen für Selbstständige, kleine Unternehmen und lokale Betriebe — aus Schwarzenbek bei Hamburg.",
      contactCta: "Unverbindlich anfragen",
    }
  : {
      back: "All posts", read: "min read", contents: "Contents",
      tocCollapse: "Collapse contents", tocExpand: "Expand contents",
      aboutAuthor: "About the author", owner: "Owner, Tracht Digital Solutions",
      bio: "Builds software, websites and digitalization solutions for small and medium-sized businesses — based in Schwarzenbek near Hamburg.",
      newer: "Newer article", older: "Older article", nav: "Article navigation",
      allArticles: "All articles", rss: "Subscribe via RSS", print: "Print",
      machine: "Machine-translated — the original is written in German.",
      contactHead: "Work together",
      contactLead: "I build websites, online shops and custom solutions for freelancers, small companies and local businesses — from Schwarzenbek near Hamburg.",
      contactCta: "Get in touch",
    };

// Author byline. A real author links to its author page and shows its own
// name/avatar/bio; a post without an author (deleted user, or legacy content)
// falls back to a neutral studio byline — the byline stays, just unlinked.
const author = post.author ?? null;
const authorName = author?.name ?? (lang === "de" ? "Tracht Digital Redaktion" : "Tracht Digital Editorial");
const authorPageHref = author ? authorHref(lang, author.slug) : null;
const authorAvatar = author?.avatarUrl ?? null;
const authorBio = author?.bio ?? tx.bio;
const authorInitials = authorName
  .split(/\s+/)
  .map((w) => w[0] ?? "")
  .join("")
  .slice(0, 2)
  .toUpperCase() || "TD";

// Public, fire-and-forget view beacon. PUBLIC_ env so the inline script
// below can read it (the build-time CONTENT_API_URL isn't exposed to the
// browser); falls back to the production gateway. Disabled on demo builds.
//
// Deliberately NOT routed through tds-runtime.json, unlike the newsletter form
// and the support widget. Three reasons, and they all point the same way: the
// beacon is `is:inline` + `define:vars`, so it cannot import the resolver
// (an inline script is not bundled, and its imports would reach the browser as
// bare specifiers); `sendBeacon` is a simple cross-origin POST, so no CORS
// allow-list can break it; and losing a view count is the cheapest failure in
// this repo. Adding a config request to every article page to protect an
// analytics ping would be the wrong trade. If the API host moves, view counts
// stop until the next rebuild — by design.
const beaconBase =
  import.meta.env.PUBLIC_CONTENT_API_URL ?? "https://api.tracht-digital.de/content";
const beaconDisabled = import.meta.env.PUBLIC_DEMO_MODE === "true";
---

<Layout
  title={`${post.title} — Journal`}
  description={post.excerpt}
  lang={lang}
  ogImage={explicitCover}
  article={{
    publishedTime: post.publishedAt,
    modifiedTime: post.updatedAt,
    author: authorName,
    section: post.category,
    slug: post.slug,
  }}
  jsonLd={jsonLd}
  sidebar
  focusable
  adsMode={adsMode}
>
  <div
    id="reading-progress"
    class="fixed top-0 left-0 right-0 z-50 h-[3px] origin-left scale-x-0 bg-[var(--color-accent)]"
    aria-hidden="true"
  >
  </div>

  <main
    id="main"
    class:list={[
      "article-shell px-5 sm:px-6 md:px-8 py-10 lg:py-12",
      showToc && "has-toc",
    ]}
  >
    {showToc && (
      <>
        <nav class="toc" aria-label={tx.contents} id="article-toc">
          <div class="toc-head">
            <p class="eyebrow toc-title">{tx.contents}</p>
            <button
              type="button"
              class="toc-toggle"
              id="toc-toggle"
              aria-expanded="true"
              aria-controls="main"
              title={tx.tocCollapse}
              aria-label={tx.tocCollapse}
              data-label-collapse={tx.tocCollapse}
              data-label-expand={tx.tocExpand}
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
            </button>
          </div>
          <ol class="toc-list">
            {sections.map((sec) => (
              <li>
                <a href={`#${sec.id}`} data-toc={sec.id} class="toc-link">
                  <span class="toc-tick" aria-hidden="true"></span>
                  <span class="toc-label">{sec.heading}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
        {/* Apply the saved fold state before first paint so the article
            column doesn't jump on load. #main + #toc-toggle are already
            parsed at this point (this runs right after the nav). */}
        <script is:inline>
          (function () {
            try {
              if (localStorage.getItem("tds-blog-toc") === "collapsed") {
                var m = document.getElementById("main");
                if (m) m.classList.add("toc-collapsed");
                var t = document.getElementById("toc-toggle");
                if (t) t.setAttribute("aria-expanded", "false");
              }
            } catch (e) {
              /* storage disabled — start expanded */
            }
          })();
        </script>
      </>
    )}

    <article class="article-col">
      <header class="mb-7">
        <div class="flex flex-wrap items-center gap-3.5 mb-3.5">
          <p class="eyebrow" style="color: var(--color-accent);">{post.category}</p>
          <span aria-hidden="true" class="w-1 h-1 bg-[var(--color-line)]"></span>
          <p class="text-[0.8125rem] text-[var(--color-muted)] tabular">
            {dateLabel && <>{dateLabel} · </>}~{readingMinutes} {tx.read}
          </p>
          {/* Reader focus mode — hides all chrome for distraction-free reading.
              Toggled here or with the `f` key; state persists per reader. */}
          <button
            type="button"
            id="focus-toggle"
            class="ml-auto inline-flex items-center gap-1.5 text-[0.8125rem] font-medium text-[var(--color-muted)] hover:text-[var(--color-ink)] transition-colors"
            aria-pressed="false"
            title={lang === "de" ? "Fokusmodus (Taste F)" : "Focus mode (press F)"}
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 7V5a2 2 0 0 1 2-2h2"></path>
              <path d="M17 3h2a2 2 0 0 1 2 2v2"></path>
              <path d="M21 17v2a2 2 0 0 1-2 2h-2"></path>
              <path d="M7 21H5a2 2 0 0 1-2-2v-2"></path>
            </svg>
            <span data-focus-label>{lang === "de" ? "Fokus" : "Focus"}</span>
          </button>
          {/* Opens the colourless print / PDF view in its own tab. */}
          <a
            href={`${pfx}/${post.slug}/print`}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 text-[0.8125rem] font-medium text-[var(--color-muted)] hover:text-[var(--color-ink)] no-underline transition-colors"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9V2h12v7"></path>
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
              <path d="M6 14h12v8H6z"></path>
            </svg>
            <span>{tx.print}</span>
          </a>
        </div>
        {/* Back arrow sits directly left of the heading (hangs into the left
            margin on lg+; inline before the title on small screens). */}
        <div class="title-row">
          <a href={`${pfx}/`} class="back-rail" aria-label={tx.back}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
          </a>
          <h1 class="display page-title" style="text-wrap: balance;">
            {post.title}
          </h1>
        </div>
        <p class="lead mt-3.5 text-[var(--color-muted)]" style="text-wrap: pretty;">
          {post.excerpt}
        </p>
        <p class="mt-4 inline-flex items-center gap-2.5">
          {authorAvatar ? (
            <img
              src={authorAvatar}
              alt=""
              class="w-7 h-7 rounded-full object-cover"
              width="28"
              height="28"
              loading="lazy"
            />
          ) : (
            <span
              aria-hidden="true"
              class="w-7 h-7 inline-flex items-center justify-center text-[11px] font-semibold tracking-wide"
              style="background: var(--tds-flat-tint); color: var(--color-primary);"
            >{authorInitials}</span>
          )}
          {authorPageHref ? (
            <a href={authorPageHref} class="text-[0.8125rem] font-medium link-underline">{authorName}</a>
          ) : (
            <span class="text-[0.8125rem] font-medium">{authorName}</span>
          )}
        </p>
        {translated && (
          <p
            class="mt-4 text-[0.8125rem] text-[var(--color-muted)] border-l-2 pl-3"
            style="border-color: var(--color-accent);"
          >
            <span aria-hidden="true">🌐 </span>{tx.machine}
          </p>
        )}
      </header>

      <div class="mt-4">
          {isBlocks ? (
            blkSplit.intro.length > 0 && (
              <BlockRenderer blocks={blkSplit.intro} ads={ads} showAds={showBlockAds} lang={lang} snippets={snippets} dropCap />
            )
          ) : (
            intro.trim().length > 0 && (
              <div class="tds-prose drop-cap" set:html={intro}></div>
            )
          )}
          {showManualAds && ads.slotInArticle && (
            <AdSlot client={ads.publisherId} slot={ads.slotInArticle} lang={lang} />
          )}
          {isBlocks
            ? blkSplit.sections.map((sec) => (
                <section class="article-sec">
                  <h2 id={sec.id}>
                    <button class="sec-head" aria-expanded="true" aria-controls={`${sec.id}-body`}>
                      <span>{sec.heading}</span>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
                    </button>
                  </h2>
                  <div class="sec-body" id={`${sec.id}-body`}>
                    <div class="sec-body-inner">
                      <BlockRenderer blocks={sec.blocks} ads={ads} showAds={showBlockAds} lang={lang} snippets={snippets} />
                    </div>
                  </div>
                </section>
              ))
            : mdSplit.sections.map((sec) => (
                <section class="article-sec">
                  <h2 id={sec.id}>
                    <button class="sec-head" aria-expanded="true" aria-controls={`${sec.id}-body`}>
                      <span>{sec.heading}</span>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
                    </button>
                  </h2>
                  <div class="sec-body" id={`${sec.id}-body`}>
                    <div class="sec-body-inner">
                      <div class="tds-prose" set:html={sec.html}></div>
                    </div>
                  </div>
                </section>
              ))}

          {showManualAds && ads.slotEndArticle && (
            <AdSlot client={ads.publisherId} slot={ads.slotEndArticle} lang={lang} />
          )}

          <aside
            class="focus-hide mt-9 p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
            style="background: var(--color-soft);"
            aria-label={tx.contactHead}
          >
            <div>
              <p class="eyebrow mb-1.5">{tx.contactHead}</p>
              <p class="text-sm text-[var(--color-muted)]" style="max-width: 44ch; text-wrap: pretty;">
                {tx.contactLead}
              </p>
            </div>
            <a href={contactUrl} class="btn-flat shrink-0">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16"></rect>
                <path d="m22 6-10 7L2 6"></path>
              </svg>
              <span>{tx.contactCta}</span>
            </a>
          </aside>

          {/* Author bio sits below the contact CTA (moved further down). */}
          <aside
            class="focus-hide grid grid-cols-[64px_1fr] gap-5 items-start mt-6 p-5"
            style="background: var(--color-soft);"
          >
            {authorAvatar ? (
              <img
                src={authorAvatar}
                alt=""
                class="w-16 h-16 rounded-full object-cover"
                width="64"
                height="64"
                loading="lazy"
              />
            ) : (
              <span
                aria-hidden="true"
                class="w-16 h-16 inline-flex items-center justify-center text-lg font-semibold tracking-wide text-white"
                style="background: var(--color-surface-navy); font-family: var(--font-display);"
              >{authorInitials}</span>
            )}
            <div>
              <p class="eyebrow mb-2">{tx.aboutAuthor}</p>
              <p class="font-semibold">
                {authorPageHref ? (
                  <a href={authorPageHref} class="link-underline">{authorName}</a>
                ) : (
                  authorName
                )}
                {!author && (
                  <span class="font-normal text-sm text-[var(--color-muted)]">· {tx.owner}</span>
                )}
              </p>
              <p class="text-sm leading-relaxed text-[var(--color-muted)] mt-2" style="text-wrap: pretty;">
                {authorBio}
              </p>
            </div>
          </aside>
      </div>

      <div class="focus-hide">
        <RelatedArticles
          posts={posts}
          currentSlug={post.slug}
          currentCategory={post.category}
          lang={lang}
        />
      </div>

      {/* Tags moved further down — below the related-articles strip. */}
      <div class="focus-hide mt-10">
        <TagList tags={post.tags} lang={lang} label="Tags" />
      </div>

      {(newerPost || olderPost) && (
        <nav class="focus-hide mt-16 grid sm:grid-cols-2 gap-4" aria-label={tx.nav}>
          {newerPost ? (
            <a href={postHref(newerPost.slug)} class="block px-5 py-4 group transition-colors bg-[var(--color-soft)] hover:bg-[var(--tds-flat-hover)]">
              <p class="eyebrow mb-2">← {tx.newer}</p>
              <p class="display-tight text-lg group-hover:text-[var(--color-primary)] transition-colors">
                {newerPost.title}
              </p>
            </a>
          ) : (
            <span class="hidden sm:block" aria-hidden="true"></span>
          )}
          {olderPost && (
            <a href={postHref(olderPost.slug)} class="block px-5 py-4 group transition-colors bg-[var(--color-soft)] hover:bg-[var(--tds-flat-hover)] sm:text-right">
              <p class="eyebrow mb-2">{tx.older} →</p>
              <p class="display-tight text-lg group-hover:text-[var(--color-primary)] transition-colors">
                {olderPost.title}
              </p>
            </a>
          )}
        </nav>
      )}

      <footer class="mt-12 pt-8 hairline-t flex flex-wrap items-baseline justify-between gap-4 text-sm">
        <a href={`${pfx}/`} class="link-underline text-[var(--color-accent)]">
          ← {tx.allArticles}
        </a>
        <a href={`${pfx}/rss`} class="link-underline text-[var(--color-muted)]">
          {tx.rss}
        </a>
      </footer>
    </article>
  </main>

  <script>
    // Reader focus mode: toggles `focus-mode` on <html> (pre-paint restore lives
    // in Layout), persists the choice, and binds the `f` key (toggle) + `Escape`
    // (exit). Ignores key presses while typing in a field.
    (function () {
      const root = document.documentElement;
      const btn = document.getElementById("focus-toggle");
      const KEY = "tds-blog-focus";
      const sync = () => {
        if (btn) btn.setAttribute("aria-pressed", String(root.classList.contains("focus-mode")));
      };
      const set = (on: boolean) => {
        root.classList.toggle("focus-mode", on);
        try { localStorage.setItem(KEY, on ? "1" : "0"); } catch { /* no-op */ }
        sync();
      };
      sync();
      btn?.addEventListener("click", () => set(!root.classList.contains("focus-mode")));
      document.addEventListener("keydown", (e) => {
        const t = e.target as HTMLElement | null;
        if (t && /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
        if (e.key === "f" && !e.metaKey && !e.ctrlKey && !e.altKey) {
          e.preventDefault();
          set(!root.classList.contains("focus-mode"));
        } else if (e.key === "Escape" && root.classList.contains("focus-mode")) {
          set(false);
        }
      });
    })();
  </script>

  <script>
    // Fold the section nav into a tick rail (each section = one line; the
    // line for the section in view expands via the scroll-spy `.on` class).
    // State persists in localStorage so it survives navigation.
    const tocShell = document.getElementById("main");
    const tocToggle = document.getElementById("toc-toggle");
    if (tocShell && tocToggle) {
      const applyToc = (collapsed: boolean) => {
        tocShell.classList.toggle("toc-collapsed", collapsed);
        tocToggle.setAttribute("aria-expanded", String(!collapsed));
        const label = collapsed
          ? tocToggle.dataset.labelExpand
          : tocToggle.dataset.labelCollapse;
        if (label) {
          tocToggle.setAttribute("aria-label", label);
          tocToggle.setAttribute("title", label);
        }
      };
      tocToggle.addEventListener("click", () => {
        const collapsed = !tocShell.classList.contains("toc-collapsed");
        applyToc(collapsed);
        try {
          localStorage.setItem("tds-blog-toc", collapsed ? "collapsed" : "open");
        } catch {
          /* storage disabled — fold state just won't persist */
        }
      });
    }

    const heads = document.querySelectorAll<HTMLButtonElement>(".sec-head");
    heads.forEach((btn) => {
      btn.addEventListener("click", () => {
        const body = document.getElementById(btn.getAttribute("aria-controls") ?? "");
        if (!body) return;
        const closed = body.classList.toggle("closed");
        btn.setAttribute("aria-expanded", String(!closed));
      });
    });

    const tocLinks = document.querySelectorAll<HTMLAnchorElement>(".toc a[data-toc]");
    tocLinks.forEach((link) => {
      link.addEventListener("click", () => {
        const id = link.dataset.toc ?? "";
        const body = document.getElementById(`${id}-body`);
        const head = document.querySelector<HTMLButtonElement>(`#${CSS.escape(id)} .sec-head`);
        if (body?.classList.contains("closed")) {
          body.classList.remove("closed");
          head?.setAttribute("aria-expanded", "true");
        }
      });
    });

    if (tocLinks.length > 0) {
      const ids = Array.from(tocLinks).map((l) => l.dataset.toc ?? "");
      const spy = () => {
        let current = ids[0];
        for (const id of ids) {
          const el = document.getElementById(id);
          if (el && el.getBoundingClientRect().top <= 140) current = id;
        }
        tocLinks.forEach((l) => l.classList.toggle("on", l.dataset.toc === current));
      };
      spy();
      addEventListener("scroll", spy, { passive: true });
      addEventListener("resize", spy, { passive: true });
    }

    // Collapsed-rail labels: a label shows exactly while its HEADING (the
    // id sits on the <h2>) is on screen (`.in-view` — several can show at
    // once and stack on the row pitch). No-IO fallback: labels still
    // reveal on hover/focus.
    if (tocLinks.length > 0 && "IntersectionObserver" in window) {
      const byId = new Map(
        Array.from(tocLinks).map((l) => [l.dataset.toc ?? "", l]),
      );
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            byId
              .get((e.target as HTMLElement).id)
              ?.classList.toggle("in-view", e.isIntersecting);
          }
        },
        { threshold: 0 },
      );
      byId.forEach((_link, id) => {
        const sec = document.getElementById(id);
        if (sec) io.observe(sec);
      });
    }

    // Fade the fixed rail out once the reader scrolls past the article
    // column (it would otherwise float over the navy site footer).
    const rail = document.getElementById("article-toc");
    const artCol = document.querySelector(".article-col");
    if (rail && artCol && "IntersectionObserver" in window) {
      new IntersectionObserver(
        ([e]) => rail.classList.toggle("rail-off", !e.isIntersecting),
        { threshold: 0 },
      ).observe(artCol);
    }
  </script>

  <script>
    const bar = document.getElementById("reading-progress");
    if (bar) {
      const update = () => {
        const doc = document.documentElement;
        const max = doc.scrollHeight - doc.clientHeight;
        bar.style.transform = `scaleX(${max > 0 ? doc.scrollTop / max : 0})`;
      };
      addEventListener("scroll", update, { passive: true });
      addEventListener("resize", update, { passive: true });
      update();
    }
  </script>

  <script is:inline define:vars={{ interestTopics }}>
    (function () {
      try {
        var match = document.cookie.match(/(?:^|; )tds-interests=([^;]*)/);
        var weights = {};
        if (match) {
          try {
            weights = JSON.parse(decodeURIComponent(match[1])) || {};
          } catch (e) {
            weights = {};
          }
        }
        interestTopics.forEach(function (t) {
          weights[t] = Math.min((weights[t] || 0) + 1, 50);
        });
        var trimmed = {};
        Object.keys(weights)
          .sort(function (a, b) {
            return weights[b] - weights[a];
          })
          .slice(0, 12)
          .forEach(function (k) {
            trimmed[k] = weights[k];
          });
        document.cookie =
          "tds-interests=" +
          encodeURIComponent(JSON.stringify(trimmed)) +
          "; Max-Age=" + 180 * 24 * 3600 +
          "; Path=/; SameSite=Lax";
      } catch (e) {
        /* cookies disabled — recommendations simply stay generic */
      }
    })();
  </script>

  {/* Fire-and-forget view beacon — bumps the post's view_count so the
      hero's "Populär" tab reflects real reads. Once per session per post,
      best-effort, never blocks. */}
  <script is:inline define:vars={{ viewSlug: post.slug, viewLang: lang, viewApiBase: beaconBase, viewDisabled: beaconDisabled }}>
    (function () {
      if (viewDisabled) return;
      try {
        var key = "tds-viewed:" + viewLang + ":" + viewSlug;
        if (sessionStorage.getItem(key)) return;
        sessionStorage.setItem(key, "1");
      } catch (e) {
        /* no sessionStorage — fall through and count the view anyway */
      }
      try {
        var url =
          viewApiBase + "/blog/" + encodeURIComponent(viewSlug) + "/view?lang=" + viewLang;
        if (navigator.sendBeacon) {
          navigator.sendBeacon(url);
        } else {
          fetch(url, { method: "POST", keepalive: true, mode: "no-cors" });
        }
      } catch (e) {
        /* best-effort analytics — ignore failures */
      }
    })();
  </script>
</Layout>
