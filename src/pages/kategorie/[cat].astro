---
import Layout from "~/layouts/Layout.astro";
import BlogPostCard from "~/components/BlogPostCard.astro";
import { byCategory } from "~/lib/routes";
import { categoryDescription } from "~/lib/metaDescription";
import { asGraph, blogSchema, breadcrumbSchema, collectionPageSchema, itemListSchema, websiteSchema } from "~/lib/jsonld";
import { categoryAlternate } from "~/lib/alternates";
import { pageTitle, siteConfig } from "~/lib/seo";

// On demand: `getStaticPaths` is not allowed on a server-rendered route, so
// the page looks its own subject up and answers 404 itself. A missing one is
// a 404 rather than an empty listing: an indexable, permanently-200 page for
// something nobody wrote is worse than nothing.
const cat = Astro.params.cat as string;
const group = await byCategory("de", cat);
if (!group) return new Response("Not found", { status: 404 });
const { name, posts } = group;

// Only when a category with the SAME slug exists in the English tree. It
// usually does not — "Webshop" is filed as "Online shop" over there — and no
// alternate is the honest answer: there is no page at the mirrored URL.
const altPath = await categoryAlternate("de", cat);

const pageUrl = `${siteConfig.url}/kategorie/${cat}`;
const title = pageTitle(name);
const description = categoryDescription(name, "de");

// The ItemList sits inside the CollectionPage rather than beside it: on its
// own it named a set of articles without ever saying which page listed them.
const jsonLd = asGraph(
  websiteSchema("de"),
  blogSchema("de"),
  collectionPageSchema({
    url: pageUrl,
    name: title,
    description,
    lang: "de",
    itemList: itemListSchema(posts.map((p) => `${siteConfig.url}/${p.slug}`)),
  }),
  breadcrumbSchema([
    { name: "Journal", url: `${siteConfig.url}/` },
    { name, url: pageUrl },
  ]),
);
---

<Layout
  title={title}
  description={description}
  jsonLd={jsonLd}
  altUrl={altPath ? new URL(altPath, siteConfig.url).toString() : null}
>
  <main id="main">
    {/* Navy head band, then the rows on a tint band — flush, no margin. */}
    <header class="jnl-band jnl-tone-navy">
      <div class="tds-shell">
        <a href="/" class="btn-back">
          <span aria-hidden="true">←</span> Alle Beiträge
        </a>
        <p class="section-num mb-4 mt-6">Journal · Kategorie</p>
        <h1 class="display page-title">
          <span class="accent-italic">{name}</span>
        </h1>
        <p class="marginalia mt-3">
          {posts.length === 1
            ? "Ein Artikel in dieser Kategorie."
            : `${posts.length} Artikel in dieser Kategorie.`}
        </p>
      </div>
    </header>

    <section class="jnl-band jnl-tone-tint">
      <div class="tds-shell">
        <ul class="jnl-stack">
          {posts.map((p) => (
            <BlogPostCard
              slug={p.slug}
              category={p.category}
              title={p.title}
              excerpt={p.excerpt}
              publishedAt={p.publishedAt}
              lang="de"
            />
          ))}
        </ul>
      </div>
    </section>
  </main>
</Layout>
