---
import Layout from "~/layouts/Layout.astro";
import BlogPostCard from "~/components/BlogPostCard.astro";
import TagList from "~/components/TagList.astro";
import { byTag } from "~/lib/routes";
import { asGraph, blogSchema, breadcrumbSchema, itemListSchema, websiteSchema } from "~/lib/jsonld";
import { tagAlternate } from "~/lib/alternates";
import { pageTitle, siteConfig } from "~/lib/seo";
import { tagDescription } from "~/lib/metaDescription";

// On demand: `getStaticPaths` is not allowed on a server-rendered route, so
// the page looks its own subject up and answers 404 itself. A missing one is
// a 404 rather than an empty listing: an indexable, permanently-200 page for
// something nobody wrote is worse than nothing.
const tag = Astro.params.tag as string;
const group = await byTag("de", tag);
if (!group) return new Response("Not found", { status: 404 });
const { posts, allPosts } = group;

// Only when the English tree really carries this tag — DE and EN tag tokens
// are written separately (`webshop` vs `online-shop`), so a prefix-swapped
// guess would point at a 404 more often than not.
const altPath = await tagAlternate("de", tag);

const jsonLd = asGraph(
  websiteSchema("de"),
  blogSchema("de"),
  itemListSchema(posts.map((p) => `${siteConfig.url}/${p.slug}`)),
  breadcrumbSchema([
    { name: "Journal", url: `${siteConfig.url}/` },
    { name: `#${tag}`, url: `${siteConfig.url}/tag/${tag}` },
  ]),
);
---

<Layout
  title={pageTitle(`#${tag}`)}
  description={tagDescription(tag, "de")}
  jsonLd={jsonLd}
  altUrl={altPath ? new URL(altPath, siteConfig.url).toString() : null}
>
  <main id="main" class="tds-shell py-16 lg:py-24">
    <header class="mb-10">
      <a href="/" class="btn-back mb-6">
        <span aria-hidden="true">←</span> Alle Beiträge
      </a>
      <p class="section-num mb-4 mt-6">Journal · Tag</p>
      <h1 class="display page-title">
        #<span class="accent-italic">{tag}</span>
      </h1>
      <p class="marginalia mt-3">
        {posts.length === 1
          ? "Ein Artikel zum Thema."
          : `${posts.length} Artikel zum Thema.`}
      </p>
    </header>

    <TagList posts={allPosts} lang="de" activeTag={tag} label="Alle Tags" />

    <ul class="list-none p-0 m-0">
      {posts.map((p) => (
        <BlogPostCard
          slug={p.slug}
          category={p.category}
          title={p.title}
          excerpt={p.excerpt}
          publishedAt={p.publishedAt}
          lang="de"
        />
      ))}
    </ul>
  </main>
</Layout>
