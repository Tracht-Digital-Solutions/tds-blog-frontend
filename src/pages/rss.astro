---
import Layout from "~/layouts/Layout.astro";
import RssInfo from "~/components/RssInfo.astro";
import { asGraph, breadcrumbSchema, websiteSchema } from "~/lib/jsonld";
import { siteConfig } from "~/lib/seo";

/**
 * /rss (DE) — the friendly RSS landing the footer links to. Static; the
 * actual feed stays at /rss.xml.
 */
const jsonLd = asGraph(
  websiteSchema("de"),
  breadcrumbSchema([
    { name: "Ratgeber", url: `${siteConfig.url}/` },
    { name: "RSS", url: `${siteConfig.url}/rss` },
  ]),
);
---

<Layout
  title="RSS abonnieren — Ratgeber"
  description="Den Ratgeber per RSS abonnieren: die Feed-Adresse, empfohlene RSS-Programme und was dich in den Beiträgen erwartet."
  jsonLd={jsonLd}
  lang="de"
>
  <main id="main">
    <RssInfo lang="de" />
  </main>
</Layout>
