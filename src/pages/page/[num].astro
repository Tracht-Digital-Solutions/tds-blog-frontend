---
import Layout from "~/layouts/Layout.astro";
import BlogPostCard from "~/components/BlogPostCard.astro";
import { translations } from "@tracht-digital-solutions/tds-shared/i18n";
import { archivePage } from "~/lib/routes";
import { paginate } from "~/lib/pagination";
import { archiveDescription } from "~/lib/metaDescription";
import { asGraph, blogSchema, itemListSchema, websiteSchema } from "~/lib/jsonld";
import { archiveAlternate } from "~/lib/alternates";
import { pageTitle, siteConfig } from "~/lib/seo";
import { PAGE_SIZE } from "~/lib/pagination";

// On demand: `getStaticPaths` is not allowed on a server-rendered route, so
// the page looks its own subject up and answers 404 itself. A missing one is
// a 404 rather than an empty listing: an indexable, permanently-200 page for
// something nobody wrote is worse than nothing.
const archive = await archivePage("de", String(Astro.params.num ?? ""));
if (!archive) return new Response("Not found", { status: 404 });
const { allPosts, page } = archive;
const t = translations.de;
const { items, hasOlder, hasNewer, pageCount } = paginate(allPosts, page);
const olderHref = page + 1 <= pageCount ? `/page/${page + 1}` : null;
const newerHref = page - 1 <= 1 ? "/" : `/page/${page - 1}`;
// Both trees hold the same articles today, so this normally resolves — but a
// page count comes from a live list and is not something to assume.
const altPath = await archiveAlternate("de", page);

// Positions continue the collection rather than restarting at 1 on every page.
const jsonLd = asGraph(
  websiteSchema("de"),
  blogSchema("de"),
  itemListSchema(
    items.map((p) => `${siteConfig.url}/${p.slug}`),
    (page - 1) * PAGE_SIZE + 1,
  ),
);
---

<Layout
  title={pageTitle(`Archiv · Seite ${page}`)}
  description={archiveDescription(page, "de")}
  jsonLd={jsonLd}
  altUrl={altPath ? new URL(altPath, siteConfig.url).toString() : null}
>
  <main id="main" class="tds-shell py-16 lg:py-24">
    <header class="mb-10">
      <p class="section-num mb-4">{t.blog.label} · Seite {page} / {pageCount}</p>
      <h1 class="display page-title">
        {t.blog.headline}
        {" "}
        <span class="accent-italic">{t.blog.headlineAccent}</span>
      </h1>
      <p class="marginalia mt-3 max-w-prose">
        Ältere Notizen aus dem Archiv. Inhaltlich nicht weniger
        gültig, nur zeitlich weiter zurück.
      </p>
    </header>

    <ul class="list-none p-0 m-0">
      {items.map((p) => (
        <BlogPostCard
          slug={p.slug}
          category={p.category}
          title={p.title}
          excerpt={p.excerpt}
          publishedAt={p.publishedAt}
          lang="de"
        />
      ))}
    </ul>

    <nav class="mt-16 flex items-center justify-between text-sm">
      {hasNewer ? (
        <a href={newerHref} class="link-underline text-[var(--color-accent)]">
          ← Neuere Artikel
        </a>
      ) : <span></span>}
      {olderHref && hasOlder ? (
        <a href={olderHref} class="link-underline text-[var(--color-accent)]">
          Ältere Artikel →
        </a>
      ) : <span></span>}
    </nav>
  </main>
</Layout>
