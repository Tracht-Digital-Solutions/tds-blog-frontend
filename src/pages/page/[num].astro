---
import Layout from "~/layouts/Layout.astro";
import BlogPostCard from "~/components/BlogPostCard.astro";
import { translations } from "@tracht-digital-solutions/tds-shared/i18n";
import { listAllPosts } from "~/lib/content-api";
import { paginate, PAGE_SIZE } from "~/lib/pagination";
import { archiveDescription } from "~/lib/metaDescription";
import { asGraph, blogSchema, websiteSchema } from "~/lib/jsonld";

export async function getStaticPaths() {
  let allPosts: Awaited<ReturnType<typeof listAllPosts>> = [];
  try {
    allPosts = await listAllPosts("de");
  } catch (err) {
    console.error("[tds-blog] getStaticPaths fetch failed:", err);
    return [];
  }

  const pageCount = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));
  const pages = [];
  for (let n = 2; n <= pageCount; n++) {
    pages.push({
      params: { num: String(n) },
      props: { allPosts, page: n },
    });
  }
  return pages;
}

interface PageProps {
  allPosts: Awaited<ReturnType<typeof listAllPosts>>;
  page: number;
}

const { allPosts, page } = Astro.props as PageProps;
const t = translations.de;
const { items, hasOlder, hasNewer, pageCount } = paginate(allPosts, page);
const olderHref = page + 1 <= pageCount ? `/page/${page + 1}` : null;
const newerHref = page - 1 <= 1 ? "/" : `/page/${page - 1}`;
const jsonLd = asGraph(websiteSchema(), blogSchema("de"));
---

<Layout
  title={`Journal · Seite ${page} — Tracht Digital Solutions`}
  description={archiveDescription(page, "de")}
  jsonLd={jsonLd}
  altUrl={null}
>
  <main id="main" class="tds-shell py-16 lg:py-24">
    <header class="mb-10">
      <p class="section-num mb-4">{t.blog.label} · Seite {page} / {pageCount}</p>
      <h1 class="display page-title">
        {t.blog.headline}
        {" "}
        <span class="accent-italic">{t.blog.headlineAccent}</span>
      </h1>
      <p class="marginalia mt-3 max-w-prose">
        Ältere Notizen aus dem Archiv. Inhaltlich nicht weniger
        gültig, nur zeitlich weiter zurück.
      </p>
    </header>

    <ul class="list-none p-0 m-0">
      {items.map((p) => (
        <BlogPostCard
          slug={p.slug}
          category={p.category}
          title={p.title}
          excerpt={p.excerpt}
          publishedAt={p.publishedAt}
          lang="de"
        />
      ))}
    </ul>

    <nav class="mt-16 flex items-center justify-between text-sm">
      {hasNewer ? (
        <a href={newerHref} class="link-underline text-[var(--color-accent)]">
          ← Neuere Artikel
        </a>
      ) : <span></span>}
      {olderHref && hasOlder ? (
        <a href={olderHref} class="link-underline text-[var(--color-accent)]">
          Ältere Artikel →
        </a>
      ) : <span></span>}
    </nav>
  </main>
</Layout>
