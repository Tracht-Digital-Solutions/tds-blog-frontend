---
import Layout from "~/layouts/Layout.astro";
import RelatedArticles from "~/components/RelatedArticles.astro";
import TagList from "~/components/TagList.astro";
import { listAllPosts, getPost } from "~/lib/content-api";
import { blogPostingSchema, breadcrumbSchema } from "~/lib/jsonld";
import { renderMarkdown } from "~/lib/marked";
import { splitSections } from "~/lib/sections";
import { siteConfig } from "~/lib/seo";

export async function getStaticPaths() {
  let posts: Awaited<ReturnType<typeof listAllPosts>> = [];
  try {
    posts = await listAllPosts();
  } catch (err) {
    console.error("[tds-blog] getStaticPaths fetch failed:", err);
    return [];
  }
  // Hand the full list down as a prop so each page can filter for
  // its related-articles strip without making a second API call.
  return posts.map((p) => ({
    params: { slug: p.slug },
    props: { lang: p.lang as "de" | "en", allPosts: posts },
  }));
}

const { slug } = Astro.params;
const { lang, allPosts } = Astro.props as {
  lang: "de" | "en";
  allPosts: Awaited<ReturnType<typeof listAllPosts>>;
};

const post = await getPost(slug as string, lang);
if (!post) {
  return new Response("Not found", { status: 404 });
}

const html = await renderMarkdown(post.body);
// Collapsible sections + TOC (design-system article layout): split the
// rendered HTML at h2 boundaries. Articles without h2s render as one
// plain body, no TOC.
const { intro, sections } = splitSections(html);
const showToc = sections.length >= 2;
const sameLangPosts = allPosts.filter((p) => p.lang === lang);

// Chronological neighbours for the prev/next footer navigation.
// "Newer" sits left (reading direction back towards the index),
// "older" right.
const ordered = [...sameLangPosts].sort(
  (a, b) => (b.publishedAt ?? "").localeCompare(a.publishedAt ?? ""),
);
const orderedIdx = ordered.findIndex((p) => p.slug === post.slug);
const newerPost = orderedIdx > 0 ? ordered[orderedIdx - 1] : null;
const olderPost =
  orderedIdx >= 0 && orderedIdx < ordered.length - 1 ? ordered[orderedIdx + 1] : null;

// Topics this article contributes to the reader's interest profile
// (see the inline cookie script at the bottom of the page).
const interestTopics = Array.from(
  new Set(
    [post.category, ...(post.tags ?? "").split(",")]
      .map((t) => t.trim().toLowerCase())
      .filter(Boolean),
  ),
);
// coverHint still wins if the post carries an explicit cover URL;
// otherwise Layout falls back to the per-post generated /og/{lang}/{slug}.png.
const explicitCover = post.coverHint?.startsWith("http") ? post.coverHint : undefined;

const dateLabel = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString(lang === "de" ? "de-DE" : "en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;

const wordCount = post.body.split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 220));

// JSON-LD: BlogPosting + BreadcrumbList. Image URL must be absolute
// for Schema.org — keep in lockstep with og:image.
const ogImagePath = explicitCover ?? `/og/${lang}/${post.slug}.png`;
const imageUrl = ogImagePath.startsWith("http")
  ? ogImagePath
  : new URL(ogImagePath, siteConfig.url).toString();

const journalLabel = "Journal";
const journalHomeUrl = lang === "de" ? `${siteConfig.url}/` : `${siteConfig.url}/en/`;
const postUrl = new URL(
  lang === "en" ? `/en/${post.slug}` : `/${post.slug}`,
  siteConfig.url,
).toString();

const jsonLd = [
  blogPostingSchema({
    slug: post.slug,
    title: post.title,
    excerpt: post.excerpt,
    body: post.body,
    category: post.category,
    publishedAt: post.publishedAt,
    updatedAt: post.updatedAt ?? null,
    lang,
    imageUrl,
    wordCount,
  }),
  breadcrumbSchema([
    { name: journalLabel, url: journalHomeUrl },
    { name: post.category, url: journalHomeUrl },
    { name: post.title, url: postUrl },
  ]),
];
---

<Layout
  title={`${post.title} — Journal`}
  description={post.excerpt}
  lang={lang}
  ogImage={explicitCover}
  article={{
    publishedTime: post.publishedAt,
    modifiedTime: post.updatedAt,
    author: "Julian Tracht",
    section: post.category,
    slug: post.slug,
  }}
  jsonLd={jsonLd}
  sidebar
>
  {/* Reading progress — thin accent bar pinned to the top edge. On
      lg+ it starts right of the article sidebar (see global.css).
      Driven by the passive scroll listener at the bottom of the page;
      scaleX keeps it off the layout/paint hot path. */}
  <div
    id="reading-progress"
    class="fixed top-0 left-0 right-0 z-50 h-[3px] origin-left scale-x-0 bg-[var(--color-accent)]"
    aria-hidden="true"
  >
  </div>

  <main id="main" class="max-w-5xl mx-auto px-6 py-10 lg:py-12">
    <article>
      <header class="max-w-[46rem] mb-7">
        <a href={lang === "de" ? "/" : "/en/"} class="btn-back">
          <span aria-hidden="true">←</span>
          {lang === "de" ? "Alle Beiträge" : "All posts"}
        </a>
        <div class="flex flex-wrap items-center gap-3.5 mt-6 mb-3.5">
          <p class="eyebrow" style="color: var(--color-accent);">{post.category}</p>
          <span aria-hidden="true" class="w-1 h-1 bg-[var(--color-line)]"></span>
          <p class="text-[0.8125rem] text-[var(--color-muted)] tabular">
            {dateLabel && <>{dateLabel} · </>}~{readingMinutes} {lang === "de" ? "Min. Lesezeit" : "min read"}
          </p>
        </div>
        <h1 class="display text-4xl md:text-5xl" style="text-wrap: balance;">
          {post.title}
        </h1>
        <p class="lead mt-3.5 text-[var(--color-muted)]" style="text-wrap: pretty;">
          {post.excerpt}
        </p>
        <p class="mt-4 inline-flex items-center gap-2.5">
          <span
            aria-hidden="true"
            class="w-7 h-7 inline-flex items-center justify-center text-[11px] font-semibold tracking-wide"
            style="background: var(--flat-tint); color: var(--color-primary);"
          >JT</span>
          <span class="text-[0.8125rem] font-medium">Julian Tracht</span>
        </p>
      </header>

      <div
        class:list={[
          "mt-4",
          showToc && "lg:grid lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-9 lg:items-start",
        ]}
      >
        {showToc && (
          <nav class="toc hidden lg:block sticky top-6" aria-label={lang === "de" ? "Inhalt" : "Contents"}>
            <p class="eyebrow mb-3.5">{lang === "de" ? "Inhalt" : "Contents"}</p>
            {sections.map((sec) => (
              <a href={`#${sec.id}`} data-toc={sec.id}>{sec.heading}</a>
            ))}
          </nav>
        )}

        <div class="max-w-[46rem]">
          {intro.trim().length > 0 && (
            <div class="prose-article drop-cap" set:html={intro}></div>
          )}
          {sections.map((sec) => (
            <section class="article-sec">
              <h2 id={sec.id}>
                <button class="sec-head" aria-expanded="true" aria-controls={`${sec.id}-body`}>
                  <span>{sec.heading}</span>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
                </button>
              </h2>
              <div class="sec-body" id={`${sec.id}-body`}>
                <div class="sec-body-inner">
                  <div class="prose-article" set:html={sec.html}></div>
                </div>
              </div>
            </section>
          ))}

          {/* Author bio — flat colour block */}
          <aside
            class="grid grid-cols-[64px_1fr] gap-5 items-start mt-9 p-5"
            style="background: var(--color-soft);"
          >
            <span
              aria-hidden="true"
              class="w-16 h-16 inline-flex items-center justify-center text-lg font-semibold tracking-wide text-white"
              style="background: var(--color-surface-navy); font-family: var(--font-display);"
            >JT</span>
            <div>
              <p class="eyebrow mb-2">{lang === "de" ? "Über den Autor" : "About the author"}</p>
              <p class="font-semibold">
                Julian Tracht
                <span class="font-normal text-sm text-[var(--color-muted)]">
                  · {lang === "de" ? "Inhaber, Tracht Digital Solutions" : "Owner, Tracht Digital Solutions"}
                </span>
              </p>
              <p class="text-sm leading-relaxed text-[var(--color-muted)] mt-2" style="text-wrap: pretty;">
                {lang === "de"
                  ? "Entwickelt Software, Websites und Digitalisierungslösungen für kleine und mittlere Unternehmen — ansässig in Schwarzenbek bei Hamburg."
                  : "Builds software, websites and digitalization solutions for small and medium-sized businesses — based in Schwarzenbek near Hamburg."}
              </p>
            </div>
          </aside>

          <TagList tags={post.tags} lang={lang} label={lang === "de" ? "Tags" : "Tags"} />
        </div>
      </div>

      <RelatedArticles
        posts={sameLangPosts}
        currentSlug={post.slug}
        currentCategory={post.category}
        lang={lang}
      />

      {(newerPost || olderPost) && (
        <nav
          class="mt-16 grid sm:grid-cols-2 gap-4"
          aria-label={lang === "de" ? "Artikel-Navigation" : "Article navigation"}
        >
          {newerPost ? (
            <a href={`/${newerPost.slug}`} class="block px-5 py-4 group transition-colors bg-[var(--color-soft)] hover:bg-[var(--flat-hover)]">
              <p class="eyebrow mb-2">← {lang === "de" ? "Neuerer Artikel" : "Newer article"}</p>
              <p class="display-tight text-lg group-hover:text-[var(--color-primary)] transition-colors">
                {newerPost.title}
              </p>
            </a>
          ) : (
            <span class="hidden sm:block" aria-hidden="true"></span>
          )}
          {olderPost && (
            <a href={`/${olderPost.slug}`} class="block px-5 py-4 group transition-colors bg-[var(--color-soft)] hover:bg-[var(--flat-hover)] sm:text-right">
              <p class="eyebrow mb-2">{lang === "de" ? "Älterer Artikel" : "Older article"} →</p>
              <p class="display-tight text-lg group-hover:text-[var(--color-primary)] transition-colors">
                {olderPost.title}
              </p>
            </a>
          )}
        </nav>
      )}

      <footer class="mt-12 pt-8 hairline-t flex flex-wrap items-baseline justify-between gap-4 text-sm">
        <a
          href={lang === "de" ? "/" : "/en/"}
          class="link-underline text-[var(--color-accent)]"
        >
          ← {lang === "de" ? "Alle Artikel" : "All articles"}
        </a>
        <a href="/rss.xml" class="link-underline text-[var(--color-muted)]">
          {lang === "de" ? "RSS abonnieren" : "Subscribe via RSS"}
        </a>
      </footer>
    </article>
  </main>

  <script>
    // Collapsible sections: every h2 is a toggle button; the body
    // animates via the grid-rows trick in global.css. Clicking a TOC
    // entry re-opens a closed section before jumping to it.
    const heads = document.querySelectorAll<HTMLButtonElement>(".sec-head");
    heads.forEach((btn) => {
      btn.addEventListener("click", () => {
        const body = document.getElementById(btn.getAttribute("aria-controls") ?? "");
        if (!body) return;
        const closed = body.classList.toggle("closed");
        btn.setAttribute("aria-expanded", String(!closed));
      });
    });

    const tocLinks = document.querySelectorAll<HTMLAnchorElement>(".toc a[data-toc]");
    tocLinks.forEach((link) => {
      link.addEventListener("click", () => {
        const id = link.dataset.toc ?? "";
        const body = document.getElementById(`${id}-body`);
        const head = document.querySelector<HTMLButtonElement>(`#${CSS.escape(id)} .sec-head`);
        if (body?.classList.contains("closed")) {
          body.classList.remove("closed");
          head?.setAttribute("aria-expanded", "true");
        }
      });
    });

    // Scrollspy: highlight the TOC entry of the last section heading
    // above the reading line.
    if (tocLinks.length > 0) {
      const ids = Array.from(tocLinks).map((l) => l.dataset.toc ?? "");
      const spy = () => {
        let current = ids[0];
        for (const id of ids) {
          const el = document.getElementById(id);
          if (el && el.getBoundingClientRect().top <= 140) current = id;
        }
        tocLinks.forEach((l) => l.classList.toggle("on", l.dataset.toc === current));
      };
      spy();
      addEventListener("scroll", spy, { passive: true });
      addEventListener("resize", spy, { passive: true });
    }
  </script>

  <script>
    // Reading progress: scale the fixed top bar with overall scroll
    // position. Passive listener + transform only, so it never blocks
    // scrolling.
    const bar = document.getElementById("reading-progress");
    if (bar) {
      const update = () => {
        const doc = document.documentElement;
        const max = doc.scrollHeight - doc.clientHeight;
        bar.style.transform = `scaleX(${max > 0 ? doc.scrollTop / max : 0})`;
      };
      addEventListener("scroll", update, { passive: true });
      addEventListener("resize", update, { passive: true });
      update();
    }
  </script>

  <script is:inline define:vars={{ interestTopics }}>
    // Interest profile: accumulate this article's category + tags as
    // weights in a first-party cookie. The "Für Sie" island on the
    // index pages reads it to rank recommendations. Stays entirely in
    // the browser — nothing is sent to a server. Counts are capped and
    // the profile is trimmed to the 12 strongest topics so the cookie
    // stays small.
    (function () {
      try {
        var match = document.cookie.match(/(?:^|; )tds-interests=([^;]*)/);
        var weights = {};
        if (match) {
          try {
            weights = JSON.parse(decodeURIComponent(match[1])) || {};
          } catch (e) {
            weights = {};
          }
        }
        interestTopics.forEach(function (t) {
          weights[t] = Math.min((weights[t] || 0) + 1, 50);
        });
        var trimmed = {};
        Object.keys(weights)
          .sort(function (a, b) {
            return weights[b] - weights[a];
          })
          .slice(0, 12)
          .forEach(function (k) {
            trimmed[k] = weights[k];
          });
        document.cookie =
          "tds-interests=" +
          encodeURIComponent(JSON.stringify(trimmed)) +
          "; Max-Age=" + 180 * 24 * 3600 +
          "; Path=/; SameSite=Lax";
      } catch (e) {
        /* cookies disabled — recommendations simply stay generic */
      }
    })();
  </script>
</Layout>
