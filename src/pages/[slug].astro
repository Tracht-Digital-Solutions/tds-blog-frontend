---
import { marked } from "marked";
import Layout from "~/layouts/Layout.astro";
import { listAllPosts, getPost } from "~/lib/content-api";

export async function getStaticPaths() {
  let posts: Awaited<ReturnType<typeof listAllPosts>> = [];
  try {
    posts = await listAllPosts();
  } catch (err) {
    console.error("[tds-blog] getStaticPaths fetch failed:", err);
    return [];
  }
  return posts.map((p) => ({
    params: { slug: p.slug },
    props: { lang: p.lang as "de" | "en" },
  }));
}

const { slug } = Astro.params;
const { lang } = Astro.props as { lang: "de" | "en" };

const post = await getPost(slug as string, lang);
if (!post) {
  return new Response("Not found", { status: 404 });
}

const html = await marked.parse(post.body);
const ogImage = post.coverHint?.startsWith("http") ? post.coverHint : "/og-default.png";
---

<Layout
  title={`${post.title} — Journal`}
  description={post.excerpt}
  lang={lang}
  ogImage={ogImage}
  article={{
    publishedTime: post.publishedAt,
    author: "Julian Tracht",
    section: post.category,
  }}
>
  <main id="main" class="max-w-3xl mx-auto px-6 py-24">
    <article>
      <header class="mb-12">
        <p class="text-xs uppercase tracking-[0.08em] text-[var(--color-accent)] mb-3">
          {post.category}
        </p>
        <h1 class="font-[var(--font-display)] text-4xl md:text-5xl leading-[1.05] tracking-tight mb-4">
          {post.title}
        </h1>
        {
          post.publishedAt && (
            <time
              class="text-sm text-[var(--color-muted)]"
              datetime={post.publishedAt}
            >
              {new Date(post.publishedAt).toLocaleDateString(lang === "de" ? "de-DE" : "en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>
          )
        }
      </header>

      <div class="prose prose-lg max-w-none" set:html={html}></div>

      <footer class="mt-16 pt-8 border-t border-[var(--color-line)]">
        <a href="/" class="text-sm text-[var(--color-accent)] hover:underline">
          ← {lang === "de" ? "Alle Artikel" : "All articles"}
        </a>
      </footer>
    </article>
  </main>
</Layout>
