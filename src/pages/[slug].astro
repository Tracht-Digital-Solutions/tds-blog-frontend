---
import Article from "~/components/Article.astro";
import { listAllPosts } from "~/lib/content-api";
import { resolveLocalizedPost } from "~/lib/localizedPost";

// German article route. Every distinct slug is reachable here (authored in
// DE, or machine-translated from EN — see localizedPost.ts).
//
// Server-rendered: the corpus is fetched here rather than handed in as props,
// because `getStaticPaths` is not allowed on an on-demand route. The page is
// cached by path, so this fetch happens once per rebuild, not once per reader.
const { slug } = Astro.params;
const allPosts = await listAllPosts();

const localized = await resolveLocalizedPost(slug as string, "de");
if (!localized) {
  return new Response("Not found", { status: 404 });
}

// One entry per slug for related + prev/next; prefer the DE row's metadata.
const bySlug = new Map<string, (typeof allPosts)[number]>();
for (const p of allPosts) {
  if (!bySlug.has(p.slug) || p.lang === "de") bySlug.set(p.slug, p);
}
const posts = [...bySlug.values()];
---

<Article localized={localized} lang="de" posts={posts} />
