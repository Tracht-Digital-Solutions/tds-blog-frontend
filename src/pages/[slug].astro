---
import Layout from "~/layouts/Layout.astro";
import RelatedArticles from "~/components/RelatedArticles.astro";
import { listAllPosts, getPost } from "~/lib/content-api";
import { blogPostingSchema, breadcrumbSchema } from "~/lib/jsonld";
import { renderMarkdown } from "~/lib/marked";
import { siteConfig } from "~/lib/seo";

export async function getStaticPaths() {
  let posts: Awaited<ReturnType<typeof listAllPosts>> = [];
  try {
    posts = await listAllPosts();
  } catch (err) {
    console.error("[tds-blog] getStaticPaths fetch failed:", err);
    return [];
  }
  // Hand the full list down as a prop so each page can filter for
  // its related-articles strip without making a second API call.
  return posts.map((p) => ({
    params: { slug: p.slug },
    props: { lang: p.lang as "de" | "en", allPosts: posts },
  }));
}

const { slug } = Astro.params;
const { lang, allPosts } = Astro.props as {
  lang: "de" | "en";
  allPosts: Awaited<ReturnType<typeof listAllPosts>>;
};

const post = await getPost(slug as string, lang);
if (!post) {
  return new Response("Not found", { status: 404 });
}

const html = await renderMarkdown(post.body);
const sameLangPosts = allPosts.filter((p) => p.lang === lang);
// coverHint still wins if the post carries an explicit cover URL;
// otherwise Layout falls back to the per-post generated /og/{lang}/{slug}.png.
const explicitCover = post.coverHint?.startsWith("http") ? post.coverHint : undefined;

const dateLabel = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString(lang === "de" ? "de-DE" : "en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;

const wordCount = post.body.split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 220));

// JSON-LD: BlogPosting + BreadcrumbList. Image URL must be absolute
// for Schema.org — keep in lockstep with og:image.
const ogImagePath = explicitCover ?? `/og/${lang}/${post.slug}.png`;
const imageUrl = ogImagePath.startsWith("http")
  ? ogImagePath
  : new URL(ogImagePath, siteConfig.url).toString();

const journalLabel = "Journal";
const journalHomeUrl = lang === "de" ? `${siteConfig.url}/` : `${siteConfig.url}/en/`;
const postUrl = new URL(
  lang === "en" ? `/en/${post.slug}` : `/${post.slug}`,
  siteConfig.url,
).toString();

const jsonLd = [
  blogPostingSchema({
    slug: post.slug,
    title: post.title,
    excerpt: post.excerpt,
    body: post.body,
    category: post.category,
    publishedAt: post.publishedAt,
    updatedAt: post.updatedAt ?? null,
    lang,
    imageUrl,
    wordCount,
  }),
  breadcrumbSchema([
    { name: journalLabel, url: journalHomeUrl },
    { name: post.category, url: journalHomeUrl },
    { name: post.title, url: postUrl },
  ]),
];
---

<Layout
  title={`${post.title} — Journal`}
  description={post.excerpt}
  lang={lang}
  ogImage={explicitCover}
  article={{
    publishedTime: post.publishedAt,
    modifiedTime: post.updatedAt,
    author: "Julian Tracht",
    section: post.category,
    slug: post.slug,
  }}
  jsonLd={jsonLd}
>
  <main id="main" class="max-w-5xl mx-auto px-6 py-16 lg:py-24">
    <article>
      <div class="text-sm mb-10">
        <a href="/" class="link-underline text-[var(--color-muted)]">
          ← {lang === "de" ? "Journal" : "Journal"}
        </a>
      </div>

      <header class="editorial-grid items-end mb-14">
        <div>
          <p class="section-num mb-5">{post.category}</p>
          <h1 class="display text-5xl md:text-6xl lg:text-7xl">
            {post.title}
          </h1>
        </div>
        <aside class="marginalia lg:pl-6 lg:border-l lg:border-[var(--color-line)] space-y-3">
          {dateLabel && (
            <div>
              <p class="eyebrow">Erschienen</p>
              <p class="mt-0.5 tabular"><strong>{dateLabel}</strong></p>
            </div>
          )}
          <div>
            <p class="eyebrow">Lesezeit</p>
            <p class="mt-0.5 tabular"><strong>~{readingMinutes} Min.</strong></p>
          </div>
          <div>
            <p class="eyebrow">Verfasst von</p>
            <p class="mt-0.5"><strong>Julian Tracht</strong></p>
          </div>
        </aside>
      </header>

      <div class="prose-article drop-cap" set:html={html}></div>

      <RelatedArticles
        posts={sameLangPosts}
        currentSlug={post.slug}
        currentCategory={post.category}
        lang={lang}
      />

      <footer class="mt-20 pt-10 hairline-t flex flex-wrap items-baseline justify-between gap-4 text-sm">
        <a
          href={lang === "de" ? "/" : "/en/"}
          class="link-underline text-[var(--color-accent)]"
        >
          ← {lang === "de" ? "Alle Artikel" : "All articles"}
        </a>
        <a href="/rss.xml" class="link-underline text-[var(--color-muted)]">
          {lang === "de" ? "RSS abonnieren" : "Subscribe via RSS"}
        </a>
      </footer>
    </article>
  </main>
</Layout>
