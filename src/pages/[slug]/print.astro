---
import PrintDoc from "~/components/PrintDoc.astro";
import { resolveLocalizedPost } from "~/lib/localizedPost";

// German print view — one per distinct slug, mirroring /[slug].astro.
const { slug } = Astro.params;
const localized = await resolveLocalizedPost(slug as string, "de");
if (!localized) {
  return new Response("Not found", { status: 404 });
}
---

<PrintDoc localized={localized} lang="de" />
