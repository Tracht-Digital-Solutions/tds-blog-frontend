---
import Layout from "~/layouts/Layout.astro";
import BlogPostCard from "~/components/BlogPostCard.astro";
import { byCategory } from "~/lib/routes";
import { asGraph, blogSchema, breadcrumbSchema, collectionPageSchema, itemListSchema, websiteSchema } from "~/lib/jsonld";
import { categoryAlternate } from "~/lib/alternates";
import { pageTitle, siteConfig } from "~/lib/seo";
import { categoryDescription } from "~/lib/metaDescription";

// On demand: `getStaticPaths` is not allowed on a server-rendered route, so
// the page looks its own subject up and answers 404 itself. A missing one is
// a 404 rather than an empty listing: an indexable, permanently-200 page for
// something nobody wrote is worse than nothing.
const cat = Astro.params.cat as string;
const group = await byCategory("en", cat);
if (!group) return new Response("Not found", { status: 404 });
const { name, posts } = group;

// Only when a category with the SAME slug exists in the German tree — see the
// DE twin for why that is usually not the case.
const altPath = await categoryAlternate("en", cat);

const pageUrl = `${siteConfig.url}/en/category/${cat}`;
const title = pageTitle(name);
const description = categoryDescription(name, "en");

// The ItemList sits inside the CollectionPage rather than beside it: on its
// own it named a set of articles without ever saying which page listed them.
const jsonLd = asGraph(
  websiteSchema("en"),
  blogSchema("en"),
  collectionPageSchema({
    url: pageUrl,
    name: title,
    description,
    lang: "en",
    itemList: itemListSchema(posts.map((p) => `${siteConfig.url}/en/${p.slug}`)),
  }),
  breadcrumbSchema([
    { name: "Journal", url: `${siteConfig.url}/en/` },
    { name, url: `${siteConfig.url}/en/category/${cat}` },
  ]),
);
---

<Layout
  title={title}
  description={description}
  lang="en"
  jsonLd={jsonLd}
  altUrl={altPath ? new URL(altPath, siteConfig.url).toString() : null}
>
  <main id="main" class="tds-shell py-16 lg:py-24">
    <header class="mb-10">
      <a href="/en/" class="btn-back mb-6">
        <span aria-hidden="true">←</span> All posts
      </a>
      <p class="section-num mb-4 mt-6">Journal · Category</p>
      <h1 class="display page-title">
        <span class="accent-italic">{name}</span>
      </h1>
      <p class="marginalia mt-3">
        {posts.length === 1
          ? "One article in this category."
          : `${posts.length} articles in this category.`}
      </p>
    </header>

    <ul class="list-none p-0 m-0">
      {posts.map((p) => (
        <BlogPostCard
          slug={p.slug}
          category={p.category}
          title={p.title}
          excerpt={p.excerpt}
          publishedAt={p.publishedAt}
          lang="en"
        />
      ))}
    </ul>
  </main>
</Layout>
