---
import Layout from "~/layouts/Layout.astro";
import BlogPostCard from "~/components/BlogPostCard.astro";
import { byCategory } from "~/lib/routes";
import { asGraph, blogSchema, breadcrumbSchema, websiteSchema } from "~/lib/jsonld";
import { siteConfig } from "~/lib/seo";
import { categoryDescription } from "~/lib/metaDescription";

// On demand: `getStaticPaths` is not allowed on a server-rendered route, so
// the page looks its own subject up and answers 404 itself. A missing one is
// a 404 rather than an empty listing: an indexable, permanently-200 page for
// something nobody wrote is worse than nothing.
const cat = Astro.params.cat as string;
const group = await byCategory("en", cat);
if (!group) return new Response("Not found", { status: 404 });
const { name, posts } = group;

const jsonLd = asGraph(
  websiteSchema(),
  blogSchema("en"),
  breadcrumbSchema([
    { name: "Journal", url: `${siteConfig.url}/en/` },
    { name, url: `${siteConfig.url}/en/category/${cat}` },
  ]),
);
---

<Layout
  title={`${name} — Journal`}
  description={categoryDescription(name, "en")}
  lang="en"
  jsonLd={jsonLd}
  altUrl={null}
>
  <main id="main" class="tds-shell py-16 lg:py-24">
    <header class="mb-10">
      <a href="/en/" class="btn-back mb-6">
        <span aria-hidden="true">←</span> All posts
      </a>
      <p class="section-num mb-4 mt-6">Journal · Category</p>
      <h1 class="display page-title">
        <span class="accent-italic">{name}</span>
      </h1>
      <p class="marginalia mt-3">
        {posts.length === 1
          ? "One article in this category."
          : `${posts.length} articles in this category.`}
      </p>
    </header>

    <ul class="list-none p-0 m-0">
      {posts.map((p) => (
        <BlogPostCard
          slug={p.slug}
          category={p.category}
          title={p.title}
          excerpt={p.excerpt}
          publishedAt={p.publishedAt}
          lang="en"
        />
      ))}
    </ul>
  </main>
</Layout>
