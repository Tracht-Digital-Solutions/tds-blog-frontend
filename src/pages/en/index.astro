---
import Layout from "~/layouts/Layout.astro";
import BlogIndex from "~/components/islands/BlogIndex.tsx";
import ForYou from "~/components/islands/ForYou.tsx";
import { listAllPosts } from "~/lib/content-api";
import { PAGE_SIZE } from "~/lib/pagination";
import { asGraph, blogSchema, websiteSchema } from "~/lib/jsonld";

const jsonLd = asGraph(websiteSchema(), blogSchema("en"));

let allPosts: Awaited<ReturnType<typeof listAllPosts>> = [];
try {
  allPosts = await listAllPosts("en");
} catch (err) {
  console.error("[tds-blog] failed to fetch posts at build time:", err);
}
---

<Layout
  title="Journal — Tracht Digital Solutions"
  description="Notes and articles from Julian Tracht."
  lang="en"
  jsonLd={jsonLd}
>
  <main id="main">
    {/* Hero + category sidebar + card grid + live search — the
        design-system blog index. Posts are baked in at build time;
        the island only filters client-side. */}
    <BlogIndex posts={allPosts} lang="en" pageSize={PAGE_SIZE} client:load />

    <div class="max-w-5xl mx-auto px-6 pb-14">
      <ForYou lang="en" client:idle />
    </div>
  </main>
</Layout>
