---
import Article from "~/components/Article.astro";
import { listAllPosts } from "~/lib/content-api";
import { resolveLocalizedPost } from "~/lib/localizedPost";

// English article route. Every distinct slug is reachable here (authored in
// EN, or machine-translated from DE at build time — see localizedPost.ts).
//
// Server-rendered: the corpus is fetched here rather than handed in as props,
// because `getStaticPaths` is not allowed on an on-demand route. The page is
// cached by path, so this fetch happens once per rebuild, not once per reader.
const { slug } = Astro.params;
const localized = await resolveLocalizedPost(slug as string, "en");
if (!localized) {
  return new Response(null, { status: 404 });
}

// The corpus only AFTER the post is known to exist: a 404 used to read every
// post first.
const allPosts = await listAllPosts();

// One entry per slug for related + prev/next; prefer the EN row's metadata.
const bySlug = new Map<string, (typeof allPosts)[number]>();
for (const p of allPosts) {
  if (!bySlug.has(p.slug) || p.lang === "en") bySlug.set(p.slug, p);
}
const posts = [...bySlug.values()];
---

<Article localized={localized} lang="en" posts={posts} />
