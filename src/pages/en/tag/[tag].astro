---
import Layout from "~/layouts/Layout.astro";
import BlogPostCard from "~/components/BlogPostCard.astro";
import TagList from "~/components/TagList.astro";
import { byTag } from "~/lib/routes";
import { asGraph, blogSchema, breadcrumbSchema, collectionPageSchema, itemListSchema, websiteSchema } from "~/lib/jsonld";
import { tagAlternate } from "~/lib/alternates";
import { pageTitle, siteConfig } from "~/lib/seo";
import { tagDescription } from "~/lib/metaDescription";

// On demand: `getStaticPaths` is not allowed on a server-rendered route, so
// the page looks its own subject up and answers 404 itself. A missing one is
// a 404 rather than an empty listing: an indexable, permanently-200 page for
// something nobody wrote is worse than nothing.
const tag = Astro.params.tag as string;
const group = await byTag("en", tag);
if (!group) return new Response("Not found", { status: 404 });
const { posts, allPosts } = group;

// Only when the German tree really carries this tag — see the DE twin.
const altPath = await tagAlternate("en", tag);

const pageUrl = `${siteConfig.url}/en/tag/${tag}`;
const title = pageTitle(`#${tag}`);
const description = tagDescription(tag, "en");

// The ItemList sits inside the CollectionPage rather than beside it: on its
// own it named a set of articles without ever saying which page listed them.
const jsonLd = asGraph(
  websiteSchema("en"),
  blogSchema("en"),
  collectionPageSchema({
    url: pageUrl,
    name: title,
    description,
    lang: "en",
    itemList: itemListSchema(posts.map((p) => `${siteConfig.url}/en/${p.slug}`)),
  }),
  breadcrumbSchema([
    { name: "Journal", url: `${siteConfig.url}/en/` },
    { name: `#${tag}`, url: `${siteConfig.url}/en/tag/${tag}` },
  ]),
);
---

<Layout
  title={title}
  description={description}
  lang="en"
  jsonLd={jsonLd}
  altUrl={altPath ? new URL(altPath, siteConfig.url).toString() : null}
>
  <main id="main">
    {/* Navy head band, sand band for the tag cloud, tint band for the rows —
        flush, no margin. */}
    <header class="jnl-band jnl-tone-navy">
      <div class="tds-shell">
        <a href="/en/" class="btn-back">
          <span aria-hidden="true">←</span> All posts
        </a>
        <p class="section-num mb-4 mt-6">Journal · Tag</p>
        <h1 class="display page-title">
          #<span class="accent-italic">{tag}</span>
        </h1>
        <p class="marginalia mt-3">
          {posts.length === 1
            ? "One article on the topic."
            : `${posts.length} articles on the topic.`}
        </p>
      </div>
    </header>

    <section class="jnl-band jnl-tone-sand">
      <div class="tds-shell">
        <TagList posts={allPosts} lang="en" activeTag={tag} label="All tags" />
      </div>
    </section>

    <section class="jnl-band jnl-tone-tint">
      <div class="tds-shell">
        <ul class="jnl-stack">
          {posts.map((p) => (
            <BlogPostCard
              slug={p.slug}
              category={p.category}
              title={p.title}
              excerpt={p.excerpt}
              publishedAt={p.publishedAt}
              lang="en"
            />
          ))}
        </ul>
      </div>
    </section>
  </main>
</Layout>
