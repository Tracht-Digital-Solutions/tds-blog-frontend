---
import Layout from "~/layouts/Layout.astro";
import RssInfo from "~/components/RssInfo.astro";
import { asGraph, breadcrumbSchema, websiteSchema } from "~/lib/jsonld";
import { siteConfig } from "~/lib/seo";

/**
 * /en/rss — the friendly RSS landing the footer links to. Static; the
 * actual feed stays at /rss.xml.
 */
const jsonLd = asGraph(
  websiteSchema(),
  breadcrumbSchema([
    { name: "Journal", url: `${siteConfig.url}/en/` },
    { name: "RSS", url: `${siteConfig.url}/en/rss` },
  ]),
);
---

<Layout
  title="Subscribe via RSS — Journal"
  description="How to subscribe to the Journal via RSS: the feed address and recommended RSS programs."
  jsonLd={jsonLd}
  lang="en"
>
  <main id="main">
    <RssInfo lang="en" />
  </main>
</Layout>
