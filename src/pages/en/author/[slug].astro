---
import Layout from "~/layouts/Layout.astro";
import AuthorPostList from "~/components/islands/AuthorPostList.tsx";
import { byAuthor } from "~/lib/routes";
import {
  asGraph,
  authorPersonId,
  blogSchema,
  breadcrumbSchema,
  itemListSchema,
  profilePageSchema,
  websiteSchema,
} from "~/lib/jsonld";
import { authorAlternate } from "~/lib/alternates";
import { pageTitle, siteConfig } from "~/lib/seo";
import { authorDescription, clampToWord } from "~/lib/metaDescription";
import type { BlogAuthor } from "@tracht-digital-solutions/tds-shared";

// On demand: `getStaticPaths` is not allowed on a server-rendered route, so
// the page looks its own subject up and answers 404 itself. A missing one is
// a 404 rather than an empty listing: an indexable, permanently-200 page for
// something nobody wrote is worse than nothing.
const group = await byAuthor("en", String(Astro.params.slug ?? ""));
if (!group) return new Response("Not found", { status: 404 });
const { author, posts } = group as { author: BlogAuthor; posts: typeof group.posts };

const pageUrl = `${siteConfig.url}/en/author/${author.slug}`;
// A real bio is CMS-authored and is the better description whenever it
// exists; the fallback only has to work for an author who has not written one.
const description = author.bio
  ? // A CMS bio is the better description, but it is written as a biography,
    // not to a length limit — clamp it the same way every generated one is.
    clampToWord(author.bio.trim())
  : authorDescription(author.name, "en");

// The @id comes from the same helper `blogPostingSchema` uses for a byline,
// so this Person and the author of every article they wrote are one node
// rather than two that merely share a name.
const personSchema = {
  "@type": "Person",
  "@id": authorPersonId(pageUrl),
  name: author.name,
  url: pageUrl,
  ...(author.bio ? { description: author.bio } : {}),
  ...(author.avatarUrl ? { image: author.avatarUrl } : {}),
};

// dateModified for the profile: the newest article it lists. The list read
// carries publishedAt only, so an edited post understates it — the harmless
// direction, and the same source the sitemap uses.
const newestPublished =
  posts.map((p) => p.publishedAt).filter(Boolean).sort().at(-1) ?? null;

const altPath = await authorAlternate("en", author.slug);

// ProfilePage with the Person as mainEntity is the shape Google documents
// for author pages. A bare Person said who this is; nothing said the page was
// about them, or when it last changed.
const jsonLd = asGraph(
  websiteSchema("en"),
  blogSchema("en"),
  profilePageSchema({
    url: pageUrl,
    lang: "en",
    person: personSchema,
    dateModified: newestPublished,
  }),
  itemListSchema(posts.map((p) => `${siteConfig.url}/en/${p.slug}`)),
  breadcrumbSchema([
    { name: "Journal", url: `${siteConfig.url}/en/` },
    { name: author.name, url: pageUrl },
  ]),
);

const cards = posts.map((p) => ({
  slug: p.slug,
  category: p.category,
  title: p.title,
  excerpt: p.excerpt,
  publishedAt: p.publishedAt,
  coverHint: p.coverHint,
  viewCount: p.viewCount ?? 0,
  author,
}));
---

<Layout
  title={pageTitle(author.name)}
  description={description}
  lang="en"
  jsonLd={jsonLd}
  altUrl={altPath ? new URL(altPath, siteConfig.url).toString() : null}
>
  <main id="main" class="tds-shell py-16 lg:py-24">
    <header class="mb-10">
      <a href="/en/" class="btn-back mb-6">
        <span aria-hidden="true">←</span> All posts
      </a>
      <p class="section-num mb-4 mt-6">Journal · Author</p>
      <div class="flex items-center gap-5">
        {author.avatarUrl ? (
          <img
            src={author.avatarUrl}
            alt=""
            width="80"
            height="80"
            class="w-20 h-20 rounded-full object-cover shrink-0"
            loading="eager"
          />
        ) : (
          <span
            aria-hidden="true"
            class="w-20 h-20 inline-flex items-center justify-center text-2xl font-semibold text-white shrink-0"
            style="background: var(--color-surface-navy); font-family: var(--font-display); border-radius: 9999px;"
          >
            {author.name.split(/\s+/).map((w) => w[0] ?? "").join("").slice(0, 2).toUpperCase()}
          </span>
        )}
        <div>
          <h1 class="display page-title">{author.name}</h1>
          <p class="marginalia mt-2">
            {posts.length === 1 ? "One article" : `${posts.length} articles`}
          </p>
        </div>
      </div>
      {author.bio && (
        <p class="lead mt-5 text-[var(--color-muted)] max-w-2xl" style="text-wrap: pretty;">
          {author.bio}
        </p>
      )}
    </header>

    {/* The list jumped from the <h1> straight to the cards’ <h3>: the one
        template on the site whose post list carries no heading of its own
        (the index has “Alle Beiträge”, a category page has its name). Visually
        hidden, because the page already says whose articles these are — the
        heading is here to close the level skip, not to add a line. */}
    <h2 class="sr-only">Articles by {author.name}</h2>
    <AuthorPostList posts={cards} lang="en" client:load />
  </main>
</Layout>
