---
import Layout from "~/layouts/Layout.astro";
import AuthorPostList from "~/components/islands/AuthorPostList.tsx";
import { byAuthor } from "~/lib/routes";
import { asGraph, blogSchema, breadcrumbSchema, websiteSchema } from "~/lib/jsonld";
import { siteConfig } from "~/lib/seo";
import { authorDescription } from "~/lib/metaDescription";
import type { BlogAuthor } from "@tracht-digital-solutions/tds-shared";

// On demand: `getStaticPaths` is not allowed on a server-rendered route, so
// the page looks its own subject up and answers 404 itself. A missing one is
// a 404 rather than an empty listing: an indexable, permanently-200 page for
// something nobody wrote is worse than nothing.
const group = await byAuthor("en", String(Astro.params.slug ?? ""));
if (!group) return new Response("Not found", { status: 404 });
const { author, posts } = group as { author: BlogAuthor; posts: typeof group.posts };

const pageUrl = `${siteConfig.url}/en/author/${author.slug}`;
// A real bio is CMS-authored and is the better description whenever it
// exists; the fallback only has to work for an author who has not written one.
const description = author.bio ? author.bio : authorDescription(author.name, "en");

const personSchema = {
  "@type": "Person",
  "@id": `${pageUrl}#person`,
  name: author.name,
  url: pageUrl,
  ...(author.bio ? { description: author.bio } : {}),
  ...(author.avatarUrl ? { image: author.avatarUrl } : {}),
};

const jsonLd = asGraph(
  websiteSchema(),
  blogSchema("en"),
  personSchema,
  breadcrumbSchema([
    { name: "Journal", url: `${siteConfig.url}/en/` },
    { name: author.name, url: pageUrl },
  ]),
);

const cards = posts.map((p) => ({
  slug: p.slug,
  category: p.category,
  title: p.title,
  excerpt: p.excerpt,
  publishedAt: p.publishedAt,
  coverHint: p.coverHint,
  viewCount: p.viewCount ?? 0,
  author,
}));
---

<Layout
  title={`${author.name} — Journal`}
  description={description}
  lang="en"
  jsonLd={jsonLd}
  altUrl={null}
>
  <main id="main" class="tds-shell py-16 lg:py-24">
    <header class="mb-10">
      <a href="/en/" class="btn-back mb-6">
        <span aria-hidden="true">←</span> All posts
      </a>
      <p class="section-num mb-4 mt-6">Journal · Author</p>
      <div class="flex items-center gap-5">
        {author.avatarUrl ? (
          <img
            src={author.avatarUrl}
            alt=""
            width="80"
            height="80"
            class="w-20 h-20 rounded-full object-cover shrink-0"
            loading="eager"
          />
        ) : (
          <span
            aria-hidden="true"
            class="w-20 h-20 inline-flex items-center justify-center text-2xl font-semibold text-white shrink-0"
            style="background: var(--color-surface-navy); font-family: var(--font-display); border-radius: 9999px;"
          >
            {author.name.split(/\s+/).map((w) => w[0] ?? "").join("").slice(0, 2).toUpperCase()}
          </span>
        )}
        <div>
          <h1 class="display page-title">{author.name}</h1>
          <p class="marginalia mt-2">
            {posts.length === 1 ? "One article" : `${posts.length} articles`}
          </p>
        </div>
      </div>
      {author.bio && (
        <p class="lead mt-5 text-[var(--color-muted)] max-w-2xl" style="text-wrap: pretty;">
          {author.bio}
        </p>
      )}
    </header>

    <AuthorPostList posts={cards} lang="en" client:load />
  </main>
</Layout>
