---
import Layout from "~/layouts/Layout.astro";
import { translations } from "@tracht-digital-solutions/tds-shared/i18n";
import { listAllPosts } from "~/lib/content-api";

const t = translations.de;

let posts: Awaited<ReturnType<typeof listAllPosts>> = [];
try {
  posts = await listAllPosts("de");
} catch (err) {
  console.error("[tds-blog] failed to fetch posts at build time:", err);
}
---

<Layout title="Journal — Tracht Digital Solutions" description="Gedanken und Artikel von Julian Tracht.">
  <main id="main" class="max-w-4xl mx-auto px-6 py-24">
    <header class="mb-16">
      <p class="text-xs uppercase tracking-[0.08em] text-[var(--color-muted)] mb-4">
        {t.blog.label}
      </p>
      <h1 class="font-[var(--font-display)] text-5xl md:text-6xl leading-[0.95] tracking-tight">
        {t.blog.headline}{" "}
        <span class="text-[var(--color-accent)]">{t.blog.headlineAccent}</span>
      </h1>
    </header>

    {
      posts.length === 0 ? (
        <p class="text-[var(--color-muted)]">No posts yet.</p>
      ) : (
        <ul class="space-y-12">
          {posts.map((p) => (
            <li class="border-b border-[var(--color-line)] pb-12 last:border-b-0">
              <a href={`/${p.slug}`} class="block group">
                <p class="text-xs uppercase tracking-[0.08em] text-[var(--color-accent)] mb-3">
                  {p.category}
                </p>
                <h2 class="font-[var(--font-display)] text-2xl md:text-3xl mb-3 group-hover:text-[var(--color-accent)] transition-colors">
                  {p.title}
                </h2>
                <p class="text-[var(--color-muted)] leading-relaxed mb-3">
                  {p.excerpt}
                </p>
                <span class="text-xs text-[var(--color-muted)]">
                  {p.publishedAt && new Date(p.publishedAt).toLocaleDateString("de-DE", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Layout>
