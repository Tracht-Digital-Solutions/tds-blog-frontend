---
import Layout from "~/layouts/Layout.astro";
import BlogPostCard from "~/components/BlogPostCard.astro";
import { translations } from "@tracht-digital-solutions/tds-shared/i18n";
import { listAllPosts } from "~/lib/content-api";
import { paginate } from "~/lib/pagination";

const t = translations.de;

let allPosts: Awaited<ReturnType<typeof listAllPosts>> = [];
try {
  allPosts = await listAllPosts("de");
} catch (err) {
  console.error("[tds-blog] failed to fetch posts at build time:", err);
}

const { items, hasOlder } = paginate(allPosts, 1);
---

<Layout title="Journal — Tracht Digital Solutions" description="Gedanken und Artikel von Julian Tracht.">
  <main id="main" class="max-w-4xl mx-auto px-6 py-24">
    <header class="mb-16">
      <p class="text-xs uppercase tracking-[0.08em] text-[var(--color-muted)] mb-4">
        {t.blog.label}
      </p>
      <h1 class="font-[var(--font-display)] text-5xl md:text-6xl leading-[0.95] tracking-tight">
        {t.blog.headline}{" "}
        <span class="text-[var(--color-accent)]">{t.blog.headlineAccent}</span>
      </h1>
    </header>

    {items.length === 0 ? (
      <p class="text-[var(--color-muted)]">Noch keine Artikel veröffentlicht.</p>
    ) : (
      <ul class="space-y-12">
        {items.map((p) => (
          <BlogPostCard
            slug={p.slug}
            category={p.category}
            title={p.title}
            excerpt={p.excerpt}
            publishedAt={p.publishedAt}
            lang="de"
          />
        ))}
      </ul>
    )}

    {hasOlder && (
      <nav class="mt-16 flex justify-end">
        <a href="/page/2" class="text-sm text-[var(--color-accent)] hover:underline">
          Ältere Artikel →
        </a>
      </nav>
    )}
  </main>
</Layout>
