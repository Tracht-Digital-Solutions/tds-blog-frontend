---
import Layout from "~/layouts/Layout.astro";
import BlogIndex from "~/components/islands/BlogIndex.tsx";
import ForYou from "~/components/islands/ForYou.tsx";
import ToolsPromo from "~/components/ToolsPromo.astro";
import { listAllPosts, listPopular, listReads } from "~/lib/content-api";
import { toIndexPost } from "~/lib/indexPosts";
import { PAGE_SIZE } from "~/lib/pagination";
import { asGraph, blogSchema, itemListSchema, organizationSchema, websiteSchema } from "~/lib/jsonld";
import { siteConfig } from "~/lib/seo";

let allPosts: Awaited<ReturnType<typeof listAllPosts>> = [];
let popular: Awaited<ReturnType<typeof listPopular>> = [];
try {
  let reads: Map<string, number>;
  [allPosts, popular, reads] = await Promise.all([listAllPosts("de"), listPopular("de", 6), listReads("de")]);
  // The filter bar's "Meistgelesen" order ranks by real reads, as the author
  // pages do; without statistics the CMS counter stays.
  if (reads.size > 0) allPosts = allPosts.map((p) => ({ ...p, viewCount: reads.get(p.slug) ?? 0 }));
} catch (err) {
  console.error("[tds-blog] failed to fetch posts at build time:", err);
}

// Built after the fetch: the graph names the articles the page actually
// shows, in the order it shows them. Only the first page is listed — the
// island filters client-side, but a crawler sees the server-rendered set.
const jsonLd = asGraph(
  websiteSchema("de"),
  blogSchema("de"),
  organizationSchema(),
  itemListSchema(allPosts.slice(0, PAGE_SIZE).map((p) => `${siteConfig.url}/${p.slug}`)),
);
---

<Layout
  title="Ratgeber — Digitalisierung, Software & Mittelstand"
  jsonLd={jsonLd}
>
  <main id="main">
    {/* Hero + category sidebar + card grid + live search — the
        design-system blog index. Posts are baked in at build time;
        the island only filters client-side. */}
    <BlogIndex posts={allPosts.map(toIndexPost)} popular={popular.map(toIndexPost)} lang="de" pageSize={PAGE_SIZE} client:load />

    {/* Both render their own full-bleed band and shell: the tools promo is the
        bordeaux band, "Für Sie" the sand one — and nothing at all without a
        reading profile, so there is never an empty band. */}
    <ToolsPromo lang="de" />
    <ForYou lang="de" client:idle />
  </main>
</Layout>
