---
import Layout from "~/layouts/Layout.astro";
import BlogPostCard from "~/components/BlogPostCard.astro";
import { listAllPosts, listTopics } from "~/lib/content-api";
import { asGraph, blogSchema, breadcrumbSchema, websiteSchema } from "~/lib/jsonld";
import { siteConfig } from "~/lib/seo";

/**
 * /aktuelles (DE) — curated "Aktuelle Themen" (from the content-api topics
 * block, admin-maintained) plus the newest posts. Both are fetched at build
 * time; a missing/unreachable topics block degrades to just the post list.
 */
const lang = "de";

let posts: Awaited<ReturnType<typeof listAllPosts>> = [];
let topics: Awaited<ReturnType<typeof listTopics>> = null;
try {
  [posts, topics] = await Promise.all([listAllPosts(lang), listTopics(lang)]);
} catch (err) {
  console.error("[tds-blog] /aktuelles build fetch failed:", err);
}

const latest = [...posts]
  .sort((a, b) => (b.publishedAt ?? "").localeCompare(a.publishedAt ?? ""))
  .slice(0, 6);

const jsonLd = asGraph(
  websiteSchema(),
  blogSchema("de"),
  breadcrumbSchema([
    { name: "Journal", url: `${siteConfig.url}/` },
    { name: "Aktuelles", url: `${siteConfig.url}/aktuelles` },
  ]),
);
---

<Layout
  title="Aktuelles — Journal"
  description="Aktuelle Themen und die neuesten Beiträge aus dem Journal."
  jsonLd={jsonLd}
  lang="de"
>
  <main id="main" class="max-w-5xl mx-auto px-6 py-16 lg:py-24">
    <header class="mb-12">
      <p class="section-num mb-4">Journal · Aktuelles</p>
      <h1 class="display text-4xl md:text-5xl">
        Aktuelle <span class="accent-italic">Themen</span>
      </h1>
      <p class="marginalia mt-3 max-w-prose">
        Worüber ich gerade nachdenke — und die neuesten Beiträge.
      </p>
    </header>

    {topics && topics.items.length > 0 && (
      <section class="mb-16" aria-labelledby="topics-heading">
        <h2 id="topics-heading" class="display text-2xl md:text-3xl mb-2">{topics.headline}</h2>
        {topics.intro && <p class="marginalia mb-6 max-w-prose">{topics.intro}</p>}
        <ul class="list-none p-0 m-0 grid gap-3 sm:grid-cols-2">
          {topics.items.map((t) => (
            <li class="list-none">
              {t.href ? (
                <a href={t.href} class="topic-card">
                  <h3 class="topic-title">{t.title}</h3>
                  {t.description && <p class="topic-desc">{t.description}</p>}
                </a>
              ) : (
                <div class="topic-card topic-card--static">
                  <h3 class="topic-title">{t.title}</h3>
                  {t.description && <p class="topic-desc">{t.description}</p>}
                </div>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    <section aria-labelledby="latest-heading">
      <h2 id="latest-heading" class="display text-2xl md:text-3xl mb-6">Neueste Beiträge</h2>
      {latest.length === 0 ? (
        <p class="marginalia">Zurzeit keine Beiträge.</p>
      ) : (
        <ul class="list-none p-0 m-0">
          {latest.map((p) => (
            <BlogPostCard
              slug={p.slug}
              category={p.category}
              title={p.title}
              excerpt={p.excerpt}
              publishedAt={p.publishedAt}
              lang="de"
            />
          ))}
        </ul>
      )}
    </section>
  </main>
</Layout>
