---
import Layout from "~/layouts/Layout.astro";
import PostCard from "~/components/PostCard.tsx";
import { listAllPosts, listTopics } from "~/lib/content-api";
import { asGraph, blogSchema, breadcrumbSchema, websiteSchema } from "~/lib/jsonld";
import { siteConfig } from "~/lib/seo";

/**
 * /aktuelles (DE) — curated "Aktuelle Themen" (from the content-api topics
 * block, admin-maintained) plus the newest posts. Both are fetched at build
 * time; a missing/unreachable topics block degrades to just the post list.
 */
const lang = "de";

let posts: Awaited<ReturnType<typeof listAllPosts>> = [];
let topics: Awaited<ReturnType<typeof listTopics>> = null;
try {
  [posts, topics] = await Promise.all([listAllPosts(lang), listTopics(lang)]);
} catch (err) {
  console.error("[tds-blog] /aktuelles build fetch failed:", err);
}

const latest = [...posts]
  .sort((a, b) => (b.publishedAt ?? "").localeCompare(a.publishedAt ?? ""))
  .slice(0, 6);

const jsonLd = asGraph(
  websiteSchema(),
  blogSchema("de"),
  breadcrumbSchema([
    { name: "Journal", url: `${siteConfig.url}/` },
    { name: "Aktuelles", url: `${siteConfig.url}/aktuelles` },
  ]),
);
---

<Layout
  title="Aktuelles — Journal"
  description="Aktuelle Themen und die neuesten Beiträge aus dem Journal."
  jsonLd={jsonLd}
  lang="de"
>
  <main id="main">
    {/* Navy hero band — mirrors the index hero so /aktuelles reads as part
        of the same journal, just statically (no slider). */}
    <section style="background: var(--color-surface-navy); color: #fff;">
      <div class="max-w-5xl mx-auto px-6 py-14 md:py-20">
        <p class="eyebrow" style="color: var(--color-accent-pink);">Journal · Aktuelles</p>
        <h1 class="display text-4xl md:text-5xl mt-3">
          Aktuelle <span class="accent-italic">Themen</span>
        </h1>
        <p class="mt-4 max-w-prose" style="color: rgba(255,255,255,.75); line-height: 1.6;">
          Worüber ich gerade nachdenke — und die neuesten Beiträge.
        </p>
      </div>
    </section>

    <div class="max-w-5xl mx-auto px-6 py-16 lg:py-20">
    {topics && topics.items.length > 0 && (
      <section class="mb-16" aria-labelledby="topics-heading">
        <h2 id="topics-heading" class="display text-2xl md:text-3xl mb-2 flex items-center gap-2.5">
          <svg class="head-ico" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2.5v3.5M12 18v3.5M2.5 12h3.5M18 12h3.5M5.1 5.1l2.5 2.5M16.4 16.4l2.5 2.5M18.9 5.1l-2.5 2.5M7.6 16.4l-2.5 2.5" />
          </svg>
          {topics.headline}
        </h2>
        {topics.intro && <p class="marginalia mb-6 max-w-prose">{topics.intro}</p>}
        <ul class="list-none p-0 m-0 grid gap-3 sm:grid-cols-2">
          {topics.items.map((t) => (
            <li class="list-none">
              {t.href ? (
                <a href={t.href} class="topic-card">
                  <h3 class="topic-title">{t.title}</h3>
                  {t.description && <p class="topic-desc">{t.description}</p>}
                </a>
              ) : (
                <div class="topic-card topic-card--static">
                  <h3 class="topic-title">{t.title}</h3>
                  {t.description && <p class="topic-desc">{t.description}</p>}
                </div>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    <section aria-labelledby="latest-heading">
      <h2 id="latest-heading" class="display text-2xl md:text-3xl mb-6 flex items-center gap-2.5">
        <svg class="head-ico" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9" /><path d="M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1.4" />
        </svg>
        Neueste Beiträge
      </h2>
      {latest.length === 0 ? (
        <p class="marginalia">Zurzeit keine Beiträge.</p>
      ) : (
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 list-none p-0 m-0">
          {latest.map((p, i) => (
            <li class={`flex${i === 0 ? " sm:col-span-2 lg:col-span-3" : ""}`}>
              {/* Static flat card — same component as the index grid. */}
              <PostCard post={p} lang="de" large={i === 0} />
            </li>
          ))}
        </ul>
      )}
    </section>
    </div>
  </main>
</Layout>
