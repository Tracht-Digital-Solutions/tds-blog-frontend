---
// Font faces must be imported here (not via @import in global.css):
// @tailwindcss/postcss inlines CSS @imports without rebasing their
// relative url(./files/*.woff2) refs, so Vite never emits the fonts.
// The two font files the first paint needs, imported for their hashed URLs so
// they can be preloaded (same pattern as the landingpage). Without it the body
// face and the 800-weight display face arrived after first paint and swapped
// in — Lighthouse measured that as the page's whole layout shift (CLS 0.2).
import bodyFont from "@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url";
import displayFont from "@fontsource/lato/files/lato-latin-900-normal.woff2?url";
import "@fontsource/lato/400.css";
import "@fontsource/lato/700.css";
import "@fontsource/lato/900.css";
import "@fontsource-variable/plus-jakarta-sans/index.css";
import "@fontsource-variable/jetbrains-mono/index.css";
import "~/styles/global.css";
import JournalHeader from "~/components/JournalHeader.astro";
import JournalFooter from "~/components/JournalFooter.astro";
import ArticleSidebar from "~/components/ArticleSidebar.astro";
import AppChrome from "~/components/AppChrome.astro";
import JsonLd from "~/components/JsonLd.astro";
import { LiveChatCta } from "@tracht-digital-solutions/tds-shared/components";
import { ConsentBanner } from "@tracht-digital-solutions/tds-shared/consent";
import {
  pageDirectionScript,
  pageTransitionOptIn,
  speculationRules,
  themeBootstrapScript,
} from "@tracht-digital-solutions/tds-shared/astro";
import { siteConfig } from "~/lib/seo";
import { isExcluded } from "~/lib/sitemapExclusions";
import { cookieBannerEnabled, adsConfig } from "~/lib/content-api";

interface Props {
  title: string;
  description?: string;
  lang?: "de" | "en";
  /** Canonical URL — defaults to the current page's URL. */
  canonical?: string;
  /**
   * Alternate-language URL for the hreflang links.
   * - `undefined` (default): auto-derive by swapping the `/en/` prefix —
   *   correct for posts (every post exists in both languages via the
   *   DeepL build fallback) and for pages whose twins mirror by name.
   * - `null`: suppress the hreflang alternates + x-default entirely
   *   (canonical only). Required for listing routes whose twin does NOT
   *   mirror by prefix: /kategorie vs /en/category, per-language tag
   *   sets and pagination counts.
   * - string: use it as the alternate URL.
   */
  altUrl?: string | null;
  /** Absolute URL or site-relative path. Used for og:image + twitter:image. */
  ogImage?: string;
  /** Article meta (only for /[slug] pages). */
  article?: {
    publishedTime?: string | null;
    /** Optional `dateModified` — falls back to publishedTime. */
    modifiedTime?: string | null;
    author?: string;
    section?: string;
    /** Slug of the article. When set, og:image defaults to /og/{lang}/{slug}.png. */
    slug?: string;
  };
  /** Optional Schema.org structured data — object or array of objects. */
  jsonLd?: object | object[];
  /** Set `noindex` for draft / non-public pages. */
  noindex?: boolean;
  /** Article chrome: fixed collapsible sidebar on lg+ instead of the
   *  top nav (which stays for small screens). */
  sidebar?: boolean;
  /** Render only the slot — no header/footer/sidebar. Used by error pages. */
  bare?: boolean;
  /** Article pages: enable the reader "focus mode" (distraction-free reading).
   *  Gates the pre-paint restore so the class is only ever set on article pages. */
  focusable?: boolean;
  /** Effective ad mode for this page (article pages resolve it from the post's
   *  `adsMode` + global config). Absent → inherit the global default mode. */
  adsMode?: "off" | "auto" | "manual";
  /** Article pages: the reading rows of the phone's settings sheet. */
  reader?: { printHref: string } | null;
  /** Article pages with a TOC: an "Inhalt" tab on the phone. */
  hasToc?: boolean;
}

const {
  title,
  description: descriptionProp,
  lang = "de",
  canonical,
  altUrl: altUrlProp,
  ogImage,
  article,
  jsonLd,
  noindex = false,
  sidebar = false,
  bare = false,
  focusable = false,
  adsMode,
  reader = null,
  hasToc = false,
} = Astro.props;

// Journal-specific default (resolved after destructuring — the default
// expression can't reference `lang` from the same destructure).
const description = descriptionProp ?? siteConfig.description[lang];

const resolvedOgImage =
  ogImage ?? (article?.slug ? `/og/${lang}/${article.slug}.png` : "/og-default.png");

const site = Astro.site?.origin ?? "https://blog.tracht-digital.de";
const url = canonical ?? new URL(Astro.url.pathname, site).toString();
const ogImageAbs = resolvedOgImage.startsWith("http")
  ? resolvedOgImage
  : new URL(resolvedOgImage, site).toString();

// Alternate-language URL. Default: same slug, /en/-prefixed for the EN
// variant — lets search engines surface the right variant per locale.
// `altUrl={null}` suppresses the links (see Props.altUrl).
const autoAltPath =
  lang === "de"
    ? Astro.url.pathname.replace(/^\//, "/en/")
    // `(\/|$)`: a bare `/en` used to keep itself as its own alternate.
    : Astro.url.pathname.replace(/^\/en(\/|$)/, "/");
// A page the panel excluded from the sitemap is also served `noindex`, and
// loses its alternates with it. Both halves are required: a sitemap omission is
// a hint a crawler may ignore, while `noindex` beside an alternate tells it to
// follow a link it is simultaneously told to disregard. `noindex` (the prop)
// stays the local override for pages that are never public — `/install`, the
// print views, the error pages.
const hidden = noindex || (await isExcluded(Astro.url.pathname));

const altUrl =
  altUrlProp === null || hidden
    ? null
    : (altUrlProp ?? new URL(autoAltPath, site).toString());
const altLang = lang === "de" ? "en" : "de";
// For the phone's language switch: the twin when there is one, else the other
// language's home. Unlike `altUrl` this exists for every page.
const appAltHref = altUrl ? new URL(altUrl).pathname : lang === "de" ? "/en/" : "/";
// Only the two homes send a returning visitor to their saved language.
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "/en/" || Astro.url.pathname === "/en";

// Language-matched RSS autodiscovery (the EN feed carries EN posts).
const rssHref = lang === "en" ? "/en/rss.xml" : "/rss.xml";

// AdSense config (build-time, admin-toggleable `ads` block). When ads are
// enabled the page's effective mode is either the one the page passed
// (article pages resolve it per-post) or the global default (other pages).
const ads = bare ? null : await adsConfig();
const adsActive = !!ads && ads.enabled && (adsMode ?? ads.defaultMode) !== "off";

/**
 * The consent manager, on every page that is not `bare`.
 *
 * This used to be two mutually exclusive mounts: an informational notice, or —
 * when advertising was on — a consent gate INSTEAD of it. That swap is the part
 * worth naming, because it read as thorough and was not: the disclosure of what
 * the site stores disappeared exactly when the site started storing more.
 *
 * One component now, and `categories` decides whether it asks a question or
 * states a fact. Advertising is the only optional purpose this site has.
 *
 * The old informational variant was additionally gated behind
 * `cookieBannerEnabled()`, a CMS toggle — fine for a notice, wrong for a gate,
 * because whether a consent must be obtained is not a content decision. The
 * toggle still silences the purely informational case; it can no longer
 * suppress a real question.
 */
const consentCategories: readonly "marketing"[] = !!ads && ads.enabled ? ["marketing"] : [];
const showConsent =
  !bare && (consentCategories.length > 0 || (await cookieBannerEnabled()));
---

<!DOCTYPE html>
<!-- data-surface selects the geometry layer from tds-shared's design
     library (surfaces/blog.css): the flat "kantig" kit — every radius 0,
     no elevation, the 800 display voice, --tds-flat-tint/-hover. Do not
     author radii locally; that is what made this repo fork .chip,
     .display, .display-tight and .eyebrow in the first place. -->
<html lang={lang} data-surface="blog" class="tds-app">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* `crossorigin` is required: fonts load in CORS mode, and a preload
        without it warms a second request that nothing uses. */}
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <!-- The cross-page transition switch, as early as it can be: Chrome decides the
         incoming page's opt-in at its first render, and the stylesheet linked at the
         end of this head often arrives later (tds-shared pageTransitionOptIn). -->
    <style is:inline set:html={pageTransitionOptIn} />
    {/* Tags each page transition forward/back, so a phone slides like an app. */}
    <script is:inline set:html={pageDirectionScript} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#070a14" media="(prefers-color-scheme: dark)" />
    {/* Installable app (tds-shared/pwa): manifest, home-screen icon. */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Journal" />
    {hidden && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" type="image/png" href="/favicon.png" sizes="any" />

        {/* No-flash theme bootstrap — shared with the landingpage and the frontend
        host (tds-shared/astro), which is what makes the choice carry across
        properties: one key, one implementation. Must stay `is:inline` and stay
        in <head> so it runs before the body parses. */}
    <script is:inline set:html={themeBootstrapScript} />
    {focusable && (
      <script is:inline>
        /* No-flash restore of the reading settings. Gated behind `focusable` so
           the classes are only ever set on article pages.
           Text size comes from the cross-site preference record the theme
           bootstrap above published (window.__tdsPrefs, cookie on
           .tracht-digital.de); the old per-origin key is the fallback for a
           reader who set it before the move. Focus mode stays per device. */
        (function () {
          try {
            if (localStorage.getItem("tds-blog-focus") === "1") {
              document.documentElement.classList.add("focus-mode");
            }
            var prefs = window.__tdsPrefs || {};
            var z = parseFloat(prefs.reader_zoom || localStorage.getItem("tds-blog-zoom") || "");
            if (z >= 0.85 && z <= 1.5 && z !== 1) {
              document.documentElement.style.setProperty("--reader-zoom", String(z));
            }
          } catch (e) { /* storage disabled — start unfocused */ }
        })();
      </script>
    )}
    {isHome && altUrl && (
      <script is:inline define:vars={{ pageLang: lang, homeAlt: altUrl }}>
        /* A returning visitor who chose the other language lands there — only
           when arriving from outside our sites (tds-shared/prefs
           redirectToSavedLocale, inlined so it acts before anything paints).
           Crawlers carry no cookie; hreflang stays authoritative. */
        (function () {
          try {
            var saved = (window.__tdsPrefs || {}).locale;
            if (!saved || saved === pageLang) return;
            var ref = document.referrer ? new URL(document.referrer).hostname : "";
            if (/(^|\.)tracht-digital\.de$/i.test(ref)) return;
            location.replace(homeAlt);
          } catch (e) {}
        })();
      </script>
    )}
    <link rel="canonical" href={url} />
    {altUrl !== null && (
      <>
        <link rel="alternate" hreflang={lang} href={url} />
        <link rel="alternate" hreflang={altLang} href={altUrl} />
        <link rel="alternate" hreflang="x-default" href={lang === "de" ? url : altUrl} />
      </>
    )}
    <link rel="alternate" type="application/rss+xml" title="TDS Journal" href={rssHref} />

    <!-- Resource hints — open early connections to the API origin
         (content-api at build time, in case any runtime asset
         resolves to it) and the sibling marketing site. -->
    <link rel="preconnect" href="https://api.tracht-digital.de" crossorigin />
    <link rel="dns-prefetch" href="https://api.tracht-digital.de" />
    <link rel="preconnect" href="https://tracht-digital.de" crossorigin />
    <link rel="dns-prefetch" href="https://tracht-digital.de" />
    {adsActive && (
      <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
    )}
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={lang === "de" ? "de_DE" : "en_GB"} />
    <meta property="og:site_name" content="TDS Journal" />

    {article?.publishedTime && (
      <meta property="article:published_time" content={article.publishedTime} />
    )}
    {article?.modifiedTime && (
      <meta property="article:modified_time" content={article.modifiedTime} />
    )}
    {article?.author && <meta property="article:author" content={article.author} />}
    {article?.section && <meta property="article:section" content={article.section} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    {jsonLd && <JsonLd data={jsonLd} />}
    {/* Near-instant navigation: prerender a link once the reader shows intent. */}
    <script is:inline type="speculationrules" set:html={speculationRules(["/og/", "/rss"])} />
  </head>
  <body>
    <a href="#main" class="absolute -top-full left-0 z-50 px-6 py-3 bg-[var(--color-surface-navy)] text-white text-sm font-semibold focus:top-0 transition-all">
      {lang === "de" ? "Zum Inhalt springen" : "Skip to content"}
    </a>
    {
      bare ? (
        <slot />
      ) : sidebar ? (
        <>
          <ArticleSidebar lang={lang} />
          <div class="with-sidebar nav-collapsed" id="page-shift">
            {/* The sidebar renders collapsed; re-open it before first paint for
                a reader who left it open. It lives HERE, not in ArticleSidebar:
                it must flip `#page-shift` too, and a script beside the aside
                runs before this wrapper exists — which left the page offset by
                the full 264px next to a 64px rail. */}
            <script is:inline>
              (function () {
                try {
                  var saved = (window.__tdsPrefs || {}).reader_sidenav || localStorage.getItem("tds-blog-sidenav");
                  if (saved === "open") {
                    document.getElementById("article-sidebar").classList.remove("collapsed");
                    document.getElementById("page-shift").classList.remove("nav-collapsed");
                    var btn = document.getElementById("sidebar-toggle");
                    if (btn) btn.setAttribute("aria-expanded", "true");
                  }
                } catch (e) {
                  /* storage disabled — stay collapsed */
                }
              })();
            </script>
            <JournalHeader lang={lang} />
            <slot />
            <JournalFooter lang={lang} />
          </div>
        </>
      ) : (
        <>
          <JournalHeader lang={lang} />
          <slot />
          <JournalFooter lang={lang} />
        </>
      )
    }

    {!bare && (
      <AppChrome lang={lang} altHref={appAltHref} reader={reader} hasToc={hasToc} />
    )}

    {/* One banner. With advertising on it is a real opt-in per purpose; with
        it off it states what the site stores and offers an acknowledgement.
        The AdSense loader below is unchanged — it still reads `tds-ad-consent`,
        which the store keeps writing. */}
    {showConsent && (
      <ConsentBanner
        client:idle
        lang={lang}
        categories={consentCategories}
        privacyUrl="https://tracht-digital.de/legal/datenschutz"
        imprintUrl="https://tracht-digital.de/legal/impressum"
      />
    )}

    {/* Upgrades the consent gates in front of video embeds. A module script,
        not an island: it needs no UI and no React — see the note in
        gatedEmbeds.ts. */}
    <script>
      import { initGatedEmbeds } from "~/lib/gatedEmbeds";
      import { startAccountPrefsSync } from "@tracht-digital-solutions/tds-shared/prefs";
      import { registerServiceWorker } from "@tracht-digital-solutions/tds-shared/app";
      initGatedEmbeds();
      // Signed in? Then theme, language and reading settings follow the
      // account to other devices (best-effort, silent).
      void startAccountPrefsSync();
      // Installable + offline reading (src/pages/sw.js.ts).
      registerServiceWorker();
    </script>

    {/* Floating support widget — self-hides unless the live-chat-cta extension
        enables the "blog" frontend in the admin.
        No apiBase prop on purpose: the widget then resolves through tds-shared's
        apiFetch, which honours the host's tds-runtime.json — so
        /install/ can re-point it (or route it through the same-origin
        proxy) without a rebuild. A hard-coded origin would silently opt the
        widget out of that. */}
    {!bare && (
      <LiveChatCta client:idle frontend="blog" lang={lang} />
    )}

    {/* Consent-gated AdSense loader. Injects adsbygoogle.js only after the
        visitor grants ad consent (now or via the banner event) — nothing
        loads and no ad cookie is set beforehand. */}
    {adsActive && ads && (
      <script is:inline define:vars={{ adsClient: ads.publisherId }}>
        (function () {
          function load() {
            if (window.__tdsAdsLoaded) return;
            window.__tdsAdsLoaded = true;
            var s = document.createElement("script");
            s.async = true;
            s.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=" + adsClient;
            s.crossOrigin = "anonymous";
            document.head.appendChild(s);
          }
          try {
            if (localStorage.getItem("tds-ad-consent") === "granted") { load(); return; }
          } catch (e) {}
          window.addEventListener("tds-ad-consent", function (e) {
            if (e && e.detail === "granted") load();
          });
        })();
      </script>
    )}

    {/* Dynamic document.title — prefixes the tab with the heading
        of whichever `<section id="…">` is currently in the viewport.
        No-ops when a page has fewer than two sections (single-post
        layout, etc). */}
    <script>
      const ORIGINAL_TITLE = document.title;
      const BRAND = ORIGINAL_TITLE.includes(" — ")
        ? ORIGINAL_TITLE.split(" — ")[0]
        : ORIGINAL_TITLE;

      const sections = document.querySelectorAll<HTMLElement>("section[id]");
      if (sections.length > 1) {
        const labelFor = (el: HTMLElement): string => {
          const explicit = el.dataset.title;
          if (explicit) return explicit;
          const eyebrow = el.querySelector(".section-num, .eyebrow");
          if (eyebrow?.textContent) {
            return eyebrow.textContent
              .replace(/^[—–-]\s*(\d+\s*\/\s*)?/, "")
              .trim();
          }
          const labelledById = el.getAttribute("aria-labelledby");
          if (labelledById) {
            const target = document.getElementById(labelledById);
            if (target?.textContent) {
              return target.textContent.trim().split(".")[0].trim();
            }
          }
          return el.getAttribute("aria-label") || el.id;
        };

        let active: string | null = null;
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const target = entry.target as HTMLElement;
              if (target.id === active) continue;
              active = target.id;
              if (target.id === "hero") {
                document.title = ORIGINAL_TITLE;
              } else {
                document.title = `${labelFor(target)} · ${BRAND}`;
              }
            }
          },
          { rootMargin: "-30% 0px -60% 0px", threshold: 0 },
        );
        sections.forEach((s) => observer.observe(s));
      }
    </script>

  </body>
</html>
