---
import "~/styles/global.css";
import JournalHeader from "~/components/JournalHeader.astro";
import JournalFooter from "~/components/JournalFooter.astro";
import ArticleSidebar from "~/components/ArticleSidebar.astro";
import JsonLd from "~/components/JsonLd.astro";

interface Props {
  title: string;
  description?: string;
  lang?: "de" | "en";
  /** Canonical URL — defaults to the current page's URL. */
  canonical?: string;
  /** Absolute URL or site-relative path. Used for og:image + twitter:image. */
  ogImage?: string;
  /** Article meta (only for /[slug] pages). */
  article?: {
    publishedTime?: string | null;
    /** Optional `dateModified` — falls back to publishedTime. */
    modifiedTime?: string | null;
    author?: string;
    section?: string;
    /** Slug of the article. When set, og:image defaults to /og/{lang}/{slug}.png. */
    slug?: string;
  };
  /** Optional Schema.org structured data — object or array of objects. */
  jsonLd?: object | object[];
  /** Set `noindex` for draft / non-public pages. */
  noindex?: boolean;
  /** Article chrome: fixed collapsible sidebar on lg+ instead of the
   *  top nav (which stays for small screens). */
  sidebar?: boolean;
  /** Render only the slot — no header/footer/sidebar. Used by error pages. */
  bare?: boolean;
}

const {
  title,
  description = "Persönlich entwickelte digitale Lösungen für den Mittelstand.",
  lang = "de",
  canonical,
  ogImage,
  article,
  jsonLd,
  noindex = false,
  sidebar = false,
  bare = false,
} = Astro.props;

const resolvedOgImage =
  ogImage ?? (article?.slug ? `/og/${lang}/${article.slug}.png` : "/og-default.png");

const site = Astro.site?.origin ?? "https://blog.tracht-digital.de";
const url = canonical ?? new URL(Astro.url.pathname, site).toString();
const ogImageAbs = resolvedOgImage.startsWith("http")
  ? resolvedOgImage
  : new URL(resolvedOgImage, site).toString();

// Alternate-language URL. Same slug, /en/-prefixed for the EN variant.
// Lets search engines surface the right variant per locale.
const altPath =
  lang === "de"
    ? Astro.url.pathname.replace(/^\//, "/en/")
    : Astro.url.pathname.replace(/^\/en\//, "/");
const altUrl = new URL(altPath, site).toString();
const altLang = lang === "de" ? "en" : "de";
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050f68" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" type="image/png" href="/favicon.png" sizes="any" />

    {/* No-flash theme bootstrap — runs synchronously in <head>
        before the body parses so the correct `data-theme` is on
        <html> by the time CSS resolves. localStorage wins over OS
        preference; if neither, follow the OS. Same key as the other
        TDS frontends so the choice carries across properties. */}
    <script is:inline>
      // Flag JS so progressive-enhancement-only styling (scroll-reveal)
      // never hides content when scripting is unavailable.
      document.documentElement.classList.add("js");
      (function () {
        try {
          var saved = localStorage.getItem("tds-theme");
          if (saved === "light" || saved === "dark") {
            document.documentElement.setAttribute("data-theme", saved);
            return;
          }
        } catch (e) { /* storage disabled — fall through to OS */ }
        var dark = window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.setAttribute("data-theme", dark ? "dark" : "light");
      })();
    </script>
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang={lang} href={url} />
    <link rel="alternate" hreflang={altLang} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={lang === "de" ? url : altUrl} />
    <link rel="alternate" type="application/rss+xml" title="TDS Journal" href="/rss.xml" />

    <!-- Resource hints — open early connections to the API origin
         (content-api at build time, in case any runtime asset
         resolves to it) and the sibling marketing site. -->
    <link rel="preconnect" href="https://api.tracht-digital.de" crossorigin />
    <link rel="dns-prefetch" href="https://api.tracht-digital.de" />
    <link rel="preconnect" href="https://tracht-digital.de" crossorigin />
    <link rel="dns-prefetch" href="https://tracht-digital.de" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={lang === "de" ? "de_DE" : "en_GB"} />
    <meta property="og:site_name" content="TDS Journal" />

    {article?.publishedTime && (
      <meta property="article:published_time" content={article.publishedTime} />
    )}
    {article?.modifiedTime && (
      <meta property="article:modified_time" content={article.modifiedTime} />
    )}
    {article?.author && <meta property="article:author" content={article.author} />}
    {article?.section && <meta property="article:section" content={article.section} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    {jsonLd && <JsonLd data={jsonLd} />}
  </head>
  <body>
    <a href="#main" class="absolute -top-full left-0 z-50 px-6 py-3 bg-[var(--color-surface-navy)] text-white text-sm font-semibold focus:top-0 transition-all">
      Skip to content
    </a>
    {
      bare ? (
        <slot />
      ) : sidebar ? (
        <>
          <ArticleSidebar lang={lang} />
          <div class="with-sidebar" id="page-shift">
            <JournalHeader lang={lang} />
            <slot />
            <JournalFooter lang={lang} />
          </div>
        </>
      ) : (
        <>
          <JournalHeader lang={lang} />
          <slot />
          <JournalFooter lang={lang} />
        </>
      )
    }

    {/* Dynamic document.title — prefixes the tab with the heading
        of whichever `<section id="…">` is currently in the viewport.
        No-ops when a page has fewer than two sections (single-post
        layout, etc). */}
    <script>
      const ORIGINAL_TITLE = document.title;
      const BRAND = ORIGINAL_TITLE.includes(" — ")
        ? ORIGINAL_TITLE.split(" — ")[0]
        : ORIGINAL_TITLE;

      const sections = document.querySelectorAll<HTMLElement>("section[id]");
      if (sections.length > 1) {
        const labelFor = (el: HTMLElement): string => {
          const explicit = el.dataset.title;
          if (explicit) return explicit;
          const eyebrow = el.querySelector(".section-num, .eyebrow");
          if (eyebrow?.textContent) {
            return eyebrow.textContent
              .replace(/^[—–-]\s*(\d+\s*\/\s*)?/, "")
              .trim();
          }
          const labelledById = el.getAttribute("aria-labelledby");
          if (labelledById) {
            const target = document.getElementById(labelledById);
            if (target?.textContent) {
              return target.textContent.trim().split(".")[0].trim();
            }
          }
          return el.getAttribute("aria-label") || el.id;
        };

        let active: string | null = null;
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const target = entry.target as HTMLElement;
              if (target.id === active) continue;
              active = target.id;
              if (target.id === "hero") {
                document.title = ORIGINAL_TITLE;
              } else {
                document.title = `${labelFor(target)} · ${BRAND}`;
              }
            }
          },
          { rootMargin: "-30% 0px -60% 0px", threshold: 0 },
        );
        sections.forEach((s) => observer.observe(s));
      }
    </script>

    {/* Scroll-reveal — flat rise-in for [data-reveal] elements as they
        enter the viewport. Honours reduced-motion (reveal immediately)
        and degrades gracefully without IntersectionObserver. Items in
        the same row get a small stagger. */}
    <script>
      const revealables = document.querySelectorAll<HTMLElement>("[data-reveal]");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!revealables.length) {
        // nothing to do
      } else if (reduce || !("IntersectionObserver" in window)) {
        revealables.forEach((el) => el.classList.add("is-in"));
      } else {
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry, i) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              el.style.setProperty("--reveal-delay", `${Math.min(i, 5) * 60}ms`);
              el.classList.add("is-in");
              obs.unobserve(el);
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
        );
        revealables.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
