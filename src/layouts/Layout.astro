---
import "~/styles/global.css";
import JournalHeader from "~/components/JournalHeader.astro";
import JournalFooter from "~/components/JournalFooter.astro";
import JsonLd from "~/components/JsonLd.astro";

interface Props {
  title: string;
  description?: string;
  lang?: "de" | "en";
  /** Canonical URL — defaults to the current page's URL. */
  canonical?: string;
  /** Absolute URL or site-relative path. Used for og:image + twitter:image. */
  ogImage?: string;
  /** Article meta (only for /[slug] pages). */
  article?: {
    publishedTime?: string | null;
    /** Optional `dateModified` — falls back to publishedTime. */
    modifiedTime?: string | null;
    author?: string;
    section?: string;
    /** Slug of the article. When set, og:image defaults to /og/{lang}/{slug}.png. */
    slug?: string;
  };
  /** Optional Schema.org structured data — object or array of objects. */
  jsonLd?: object | object[];
  /** Set `noindex` for draft / non-public pages. */
  noindex?: boolean;
}

const {
  title,
  description = "Persönlich entwickelte digitale Lösungen für den Mittelstand.",
  lang = "de",
  canonical,
  ogImage,
  article,
  jsonLd,
  noindex = false,
} = Astro.props;

const resolvedOgImage =
  ogImage ?? (article?.slug ? `/og/${lang}/${article.slug}.png` : "/og-default.png");

const site = Astro.site?.origin ?? "https://blog.tracht-digital.de";
const url = canonical ?? new URL(Astro.url.pathname, site).toString();
const ogImageAbs = resolvedOgImage.startsWith("http")
  ? resolvedOgImage
  : new URL(resolvedOgImage, site).toString();

// Alternate-language URL. Same slug, /en/-prefixed for the EN variant.
// Lets search engines surface the right variant per locale.
const altPath =
  lang === "de"
    ? Astro.url.pathname.replace(/^\//, "/en/")
    : Astro.url.pathname.replace(/^\/en\//, "/");
const altUrl = new URL(altPath, site).toString();
const altLang = lang === "de" ? "en" : "de";
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050f68" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang={lang} href={url} />
    <link rel="alternate" hreflang={altLang} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={lang === "de" ? url : altUrl} />
    <link rel="alternate" type="application/rss+xml" title="TDS Journal" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={lang === "de" ? "de_DE" : "en_GB"} />
    <meta property="og:site_name" content="TDS Journal" />

    {article?.publishedTime && (
      <meta property="article:published_time" content={article.publishedTime} />
    )}
    {article?.modifiedTime && (
      <meta property="article:modified_time" content={article.modifiedTime} />
    )}
    {article?.author && <meta property="article:author" content={article.author} />}
    {article?.section && <meta property="article:section" content={article.section} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    {jsonLd && <JsonLd data={jsonLd} />}
  </head>
  <body>
    <a href="#main" class="absolute -top-full left-0 z-50 px-6 py-3 bg-[var(--color-primary)] text-white text-sm font-semibold focus:top-0 transition-all">
      Skip to content
    </a>
    <JournalHeader />
    <slot />
    <JournalFooter />
  </body>
</html>
